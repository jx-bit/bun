+        ln -fs "$RUNNER_TEMP/.bun/bin/bun" "$RUNNER_TEMP/.bun/bin/bunx" 2>/dev/null \
+          || cp -f "$RUNNER_TEMP"/.bun/bin/bun* "$RUNNER_TEMP/.bun/bin/bunx"
         echo "$RUNNER_TEMP/.bun/bin" >> "$GITHUB_PATH"
diff --git a/.github/scripts/build-ohos-container.sh b/.github/scripts/build-ohos-container.sh
new file mode 100644
index 00000000000..1a223d905cc
--- /dev/null
+++ b/.github/scripts/build-ohos-container.sh
@@ -0,0 +1,404 @@
+#!/bin/bash
+# Build jy-bun for OHOS aarch64 INSIDE the social4hyq ci-runner container.
+#
+# Replicates social4hyq bun.rb's install-block environment (Formula/b/bun.rb
+# lines 192-256): ohos-cross-libs + ohos-icu scaffolding, LD_LIBRARY_PATH,
+# CC/CXX, rust env. Builds OUR jy-bun source (NOT the formula's ohos-bun
+# source) with --webkit=local (our pinned WebKit fork at vendor/WebKit).
+#
+# Why a script, not inline YAML: the env setup is ~80 lines with many brew
+# --prefix expansions and symlinks; a heredoc inside docker exec forces
+# brittle nested-quoting. A committed script is syntax-checkable (bash -n)
+# and mirrors social4hyq's own .github/scripts/build.sh layout.
+#
+# Preconditions (set up by the workflow before invoking this):
+#   - `brew trust social4hyq/core` done → `brew install --only-dependencies`
+#     poured llvm@21, ohos-sdk, icu4c@78, bun-bootstrap, openssl@3, cmake, ninja.
+#   - rust-nightly resource staged at /data/storage/el2/base/tmp/rust-$RUST_TOOLCHAIN.
+#   - WebKit fork checked out at /workspace/bun/vendor/WebKit.
+#   - bun install already run (root + src/node-fallbacks).
+#
+# Signing: NOT done here. The container runs a Linux kernel (not OHOS), so
+# unsigned ELFs exec fine (the musl loader does not check .codesign —
+# confirmed: cargo reached symbol-relocation before failing on OpenSSL).
+# The release workflows pre-sign the final binary with ohos-selfsign
+# (src/ohos_sign) before publishing.
+#
+# Run via:
+#   docker exec -e RUST_TOOLCHAIN -e NINJA_JOBS "$CONTAINER" \
+#     bash /workspace/bun/.github/scripts/build-ohos-container.sh
+set -euo pipefail
+
+: "${RUST_TOOLCHAIN:?RUST_TOOLCHAIN must be set (passed via docker exec -e)}"
+: "${NINJA_JOBS:=2}"
+
+BREW_PREFIX=$(brew --prefix)
+LLVM_PREFIX=$(brew --prefix llvm@21)
+# 2026-09-12: upstream bun.rb dropped its direct ohos-sdk dependency — the sdk
+# now hangs off llvm@21's deps, renamed with an @version suffix (bun.rb resolves
+# it via llvm.deps.find { |dep| dep.name.start_with?("ohos-sdk@") }). Resolve
+# the name from llvm@21's current formula so this tracks the floating tap;
+# fall back to the legacy name for older tap states, and to the image's baked
+# keg when the new bottle cannot be poured (atomgit CDN).
+SDK_FORMULA=$(brew deps --include-build llvm@21 2>/dev/null | grep -E '^ohos-sdk' | head -1 || true)
+SDK_FORMULA=${SDK_FORMULA:-ohos-sdk}
+if [ ! -d "$(brew --prefix "$SDK_FORMULA" 2>/dev/null || true)" ]; then
+  echo "sdk keg '$SDK_FORMULA' missing; pouring"
+  brew install "$SDK_FORMULA" || echo "::warning::$SDK_FORMULA pour failed; trying the legacy keg path"
+fi
+SDK_PREFIX=$(brew --prefix "$SDK_FORMULA" 2>/dev/null || true)
+[ -d "$SDK_PREFIX" ] || SDK_PREFIX="$BREW_PREFIX/opt/ohos-sdk"
+[ -d "$SDK_PREFIX" ] || { echo "::error::no ohos-sdk keg (formula '$SDK_FORMULA' and legacy opt/ohos-sdk both absent)"; exit 1; }
+
+# ── sysroot layout probe (2026-09-17) ─────────────────────────────────
+# The renamed ohos-sdk-native keg (26.0.0.18) does not carry native/sysroot —
+# the layout changed when the tap renamed the formula. Probe the known
+# layouts and fall back to the image's baked legacy versioned keg
+# (opt/ohos-sdk@<ver>, guaranteed present in the pinned image).
+SDK_SYSROOT=""
+for cand in \
+    "$SDK_PREFIX/native/sysroot" \
+    "$SDK_PREFIX/sysroot" \
+    "$BREW_PREFIX"/opt/ohos-sdk@*/native/sysroot \
+    "$BREW_PREFIX/opt/ohos-sdk/native/sysroot"; do
+    [ -d "$cand" ] && { SDK_SYSROOT="$cand"; break; }
+done
+if [ -z "$SDK_SYSROOT" ]; then
+    echo "::error::no OHOS sysroot under any known layout (formula '$SDK_FORMULA'); ohos-sdk* keg tops:"
+    for d in "$BREW_PREFIX"/opt/ohos-sdk*; do
+        [ -d "$d" ] && { echo "  $d:"; ls "$d" 2>/dev/null | sed 's/^/    /' | head -8; }
+    done
+    exit 1
+fi
+echo "OHOS sysroot: $SDK_SYSROOT"
+SDK_ROOT_DIR=$(dirname "$SDK_SYSROOT")
+ICU_PREFIX=$(brew --prefix icu4c@78)
+# The build driver bun: SELF-HOSTED FIRST — the workflow stages our own
+# verified build at /workspace/bun/.driver-bun/bun (run #338 showed the tap
+# fork's bun ignores BUN_INSTALL_IGNORE_SCRIPTS and rolls back installs on
+# postinstall failure non-deterministically, so the floating tap kegs are
+# only a fallback). Same acceptance rule as everywhere else: a candidate
+# only counts once its binary actually runs.
+BUN_BOOT_DIR=""
+if [ -x /workspace/bun/.driver-bun/bun ] \
+    && /workspace/bun/.driver-bun/bun --version >/dev/null 2>&1; then
+  BUN_BOOT_DIR=/workspace/bun/.driver-bun
+else
+  for k in bun-bootstrap bun bun@1.4; do
+    if ! "$(brew --prefix "$k" 2>/dev/null || true)/bin/bun" --version >/dev/null 2>&1; then
+      env -u HOMEBREW_OHOS_BOTTLE_BINARY_SIGN brew install --force "$k" >/dev/null 2>&1 \
+        || env -u HOMEBREW_OHOS_BOTTLE_BINARY_SIGN brew install --force "social4hyq/core/$k" >/dev/null 2>&1 \
+        || true
+    fi
+    p="$(brew --prefix "$k" 2>/dev/null || true)/bin"
+    if [ -x "$p/bun" ] && "$p/bun" --version >/dev/null 2>&1; then
+      BUN_BOOT_DIR="$p"
+      break
+    fi
+  done
+fi
+[ -n "$BUN_BOOT_DIR" ] \
+  || { echo "::error::no build driver bun (self-hosted + all kegs unusable)"; exit 1; }
+echo "build driver bun: $BUN_BOOT_DIR/bun ($("$BUN_BOOT_DIR/bun" --version 2>/dev/null | head -1))"
+RUST_HOME="/data/storage/el2/base/tmp/rust-${RUST_TOOLCHAIN}"
+SRC=/workspace/bun
+cd "$SRC"
+
+# ── Build environment (bun.rb lines 192-247) ──────────────────────────
+# rust cargo NEEDS libssl/libcrypto/libz (git2/registry transport); without
+# them the musl loader hits "Error relocating cargo: SSL_get_error/zlibVersion:
+# symbol not found" → 127 (bun.rb lines 195-199 document this exact failure).
+# lld from llvm@21 also has runtime deps on libxml2/zlib; brew superenv
+# strips system lib paths, so inject them explicitly (bun.rb lines 195-199).
+# IMPORTANT: brew installs these under opt/<name>/lib (formula_opt_lib), NOT
+# lib/<name>/lib — using the wrong path silently leaves libz.so unfound.
+export LD_LIBRARY_PATH="$BREW_PREFIX/opt/openssl@3/lib:$BREW_PREFIX/opt/libxml2/lib:$BREW_PREFIX/opt/zlib/lib:${LD_LIBRARY_PATH:-}"
+# llvm@21 only ships llvm-strip; bun's build script needs `strip` (bun.rb 201-202).
+mkdir -p .bin
+ln -sf "$LLVM_PREFIX/bin/llvm-strip" .bin/strip
+# llvm@21 was split upstream in the tap (09-07): lld now ships in the lld@21
+# formula — put its bin on PATH so the ld.lld probe (>=21.1.0) finds 21.1.8
+# before the ohos-sdk's 15.0.4.
+LLD_PREFIX=$(brew --prefix lld@21 2>/dev/null || true)
+export PATH="${LLD_PREFIX:+$LLD_PREFIX/bin:}$LLVM_PREFIX/bin:$RUST_HOME/bin:$BUN_BOOT_DIR:$BREW_PREFIX/bin:.bin:${PATH:-}"
+# CC/CXX: raw llvm@21 clang (no signing shims — device signs at install time).
+export CC="$LLVM_PREFIX/bin/clang"
+export CXX="$LLVM_PREFIX/bin/clang++"
+export CARGO_HOME=/root/.cargo
+export RUSTUP_HOME="$RUST_HOME"
+export RUSTUP_TOOLCHAIN="$RUST_TOOLCHAIN"
+export OHOS_SDK_ROOT="$SDK_ROOT_DIR"
+export OHOS_SYSROOT="$SDK_SYSROOT"
+export OHOS_LLVM_PREFIX="$LLVM_PREFIX"      # bun.rb 235
+export BUN_INSTALL_IGNORE_SCRIPTS=1
+export TMPDIR="/data/storage/el2/base/tmp"  # bun.rb 247 (EL2 tmp, musl tmpfile path)
+unset RUSTC_WRAPPER || true                 # bun.rb 230 (clear sccache etc.)
+ca_bundle="$BREW_PREFIX/etc/ca-certificates/cert.pem"
+[ -f "$ca_bundle" ] && export SSL_CERT_FILE="$ca_bundle" CURL_CA_BUNDLE="$ca_bundle" || true
+
+# ── Git SHA for build_options.rs ──────────────────────────────────────
+# config.ts getGitRevision() reads GITHUB_SHA first, then `git rev-parse HEAD`,
+# then falls back to the literal "unknown". The container has no git
+# (Harmonybrew musl), so rev-parse throws and getGitRevision returns "unknown"
+# (7 chars). That lands in build_options::SHA; env.rs:58 then does
+# const_str_slice(SHA, 0, 9) → split_at(9) → const-eval panic "mid > len"
+# (E0080) during `cargo build`. The workflow passes GITHUB_SHA via docker exec
+# -e; mirror it into GIT_SHA (the third env var getGitRevision checks) so the
+# bun configure subprocess definitely sees a 40-char SHA regardless of how the
+# runtime reshuffles env. If somehow empty, derive from the checkout dir.
+if [ -z "${GITHUB_SHA:-}" ]; then
+  GITHUB_SHA=$(git -C "$SRC" rev-parse HEAD 2>/dev/null || true)
+fi
+if [ -n "$GITHUB_SHA" ]; then
+  export GITHUB_SHA GIT_SHA="$GITHUB_SHA"
+  echo "=== build SHA: $GITHUB_SHA ==="
+else
+  echo "::warning::no GITHUB_SHA and git rev-parse failed; build_options::SHA will be 'unknown' (env.rs const_str_slice panic risk)"
+fi
+
+echo "=== toolchain ==="
+rustc --version
+cargo --version
+clang --version | head -1
+"$BUN_BOOT_DIR/bun" --version
+
+# ── esbuild OHOS platform fix ──────────────────────────────────────────
+# esbuild's npm shim (node_modules/.bin/esbuild, shebang #!/usr/bin/env
+# node) locates its native binary via process.platform. OHOS node reports
+# "openharmony", which esbuild's knownPlatformPackages map doesn't list →
+# "Unsupported platform: openharmony arm64 LE". (Self-hosted dodges this
+# only because its build dir persists across runs, so ninja skips already-
+# generated esbuild outputs; our ephemeral container re-runs every rule.)
+#
+# ESBUILD_BINARY_PATH bypasses ALL platform detection — esbuild's
+# generateBinPath checks it first and returns it directly (esbuild@0.21.5
+# bin/esbuild:116, confirmed via source). Point it at the @esbuild/linux-arm64
+# native binary: a statically-linked Go binary that runs on musl (CGO_ENABLED=0).
+#
+# @esbuild/linux-arm64 is an optionalDependency filtered by {os:linux}.
+# bun-bootstrap reports process.platform="openharmony" → bun skips it. So
+# force-install it explicitly; if bun still refuses (os filtering on explicit
+# installs), extract the tarball directly from the npm registry (the runner is
+# GitHub-hosted, not behind the China network — registry.npmjs.org is direct).
+ESBUILD_BIN="$SRC/node_modules/@esbuild/linux-arm64/bin/esbuild"
+if [ ! -x "$ESBUILD_BIN" ]; then
+  echo "=== @esbuild/linux-arm64 missing (bun skipped: openharmony≠linux), force-installing ==="
+  "$BUN_BOOT_DIR/bun" add @esbuild/linux-arm64@0.21.5 --no-save 2>&1 | tail -3 || true
+fi
+if [ ! -x "$ESBUILD_BIN" ]; then
+  echo "=== bun add refused (os filtering); extracting tarball directly ==="
+  mkdir -p "$SRC/node_modules/@esbuild"
+  curl -fsSL "https://registry.npmjs.org/@esbuild/linux-arm64/-/linux-arm64-0.21.5.tgz" -o /tmp/esbuild-arm64.tgz
+  mkdir -p /tmp/esbuild-arm64-x
+  tar xzf /tmp/esbuild-arm64.tgz -C /tmp/esbuild-arm64-x
+  mv /tmp/esbuild-arm64-x/package "$SRC/node_modules/@esbuild/linux-arm64"
+  rm -rf /tmp/esbuild-arm64.tgz /tmp/esbuild-arm64-x
+fi
+if [ ! -x "$ESBUILD_BIN" ]; then
+  echo "ERROR: $ESBUILD_BIN not found after force-install; esbuild rules will fail"
+  exit 1
+fi
+# Verify the native binary actually runs on this musl userspace (it must —
+# esbuild execs it; a glibc-linked binary would fail here).
+"$ESBUILD_BIN" --version || { echo "ERROR: esbuild native binary won't execute (not static?)"; exit 1; }
+export ESBUILD_BINARY_PATH="$ESBUILD_BIN"
+echo "=== ESBUILD_BINARY_PATH=$ESBUILD_BINARY_PATH ==="
+
+# ── Self-compile __n1 libcxx from LLVM source ────────────────────────
+# The OHOS device's libc++_shared.so uses _LIBCPP_ABI_NAMESPACE=__n1.
+# llvm@21's prebuilt cross-libs use __1. With full symbol export (方案B),
+# v8 symbols mangled as __1 would mismatch the device's __n1 → crash.
+# Self-compile libcxx/libcxxabi/libunwind with -DLIBCXX_ABI_NAMESPACE=__n1
+# so headers AND .a symbols are __n1 — matches the device.
+#
+# Strategy mirrors social4hyq llvm@21.rb build_multiarch_runtimes,
+# with the single change __h → __n1. Cached: only first run pays ~10min.
+CROSS="$SRC/build/ohos-cross-libs"
+LLVM_SRC_TARBALL="llvm-project-21.1.8.src.tar.xz"
+LLVM_SRC_URL="https://github.com/llvm/llvm-project/releases/download/llvmorg-21.1.8/${LLVM_SRC_TARBALL}"
+LIBCXX_N1_STAMP="$CROSS/.N1_BUILT_OK"
+
+if [ -f "$LIBCXX_N1_STAMP" ]; then
+  echo "=== cross-libs cache hit (ABI __n1) ==="
+else
+  echo "=== self-compiling __n1 libcxx from LLVM 21.1.8 source ==="
+  rm -rf "$CROSS"
+  mkdir -p "$CROSS"
+
+  # Download LLVM source (host runner has better network than container)
+  if [ ! -f "/tmp/${LLVM_SRC_TARBALL}" ]; then
+    echo "=== downloading ${LLVM_SRC_TARBALL} ==="
+    curl -fsSL "$LLVM_SRC_URL" -o "/tmp/${LLVM_SRC_TARBALL}" || {
+      echo "ERROR: failed to download LLVM source"
+      exit 1
+    }
+  fi
+  echo "=== extracting LLVM source ==="
+  rm -rf /tmp/llvm-project-src
+  mkdir -p /tmp/llvm-project-src
+  tar xf "/tmp/${LLVM_SRC_TARBALL}" -C /tmp/llvm-project-src --strip-components=1
+
+  LLVM_SRC=/tmp/llvm-project-src
+  BUILD_DIR=/tmp/libcxx-n1-build
+
+  # Patch: musl doesn't provide strtoll_l/strtoull_l (glibc extensions).
+  # Replace with non-locale versions (locale arg ignored).
+  LINUX_H="$LLVM_SRC/libcxx/include/__locale_dir/support/linux.h"
+  if [ -f "$LINUX_H" ]; then
+    sed -i 's/strtoll_l(\([^,]*\),\([^,]*\),\([^,]*\),[^)]*)/strtoll(\1,\2,\3)/g; s/strtoull_l(\([^,]*\),\([^,]*\),\([^,]*\),[^)]*)/strtoull(\1,\2,\3)/g' "$LINUX_H"
+    echo "=== patched linux.h: strtoll_l/strtoull_l → strtoll/strtoull (dropped locale arg) ==="
+  fi
+
+  # Temporarily hide llvm@21 cmake config: the brew bottle ships
+  # LLVMExports.cmake that references missing static libs (e.g.
+  # libLLVMDemangle.a). find_package(LLVM) loads it and fails.
+  # The runtimes build is standalone and doesn't need it.
+  LLVM_CMAKE_DIR="$LLVM_PREFIX/lib/cmake"
+  if [ -d "$LLVM_CMAKE_DIR" ]; then
+    mv "$LLVM_CMAKE_DIR" "${LLVM_CMAKE_DIR}.bak"
+    echo "=== temporarily hiding llvm@21 cmake config ==="
+  fi
+
+  # Stage 1: libunwind standalone
+  echo "=== Stage 1: libunwind ==="
+  cmake -G Ninja -S "$LLVM_SRC/runtimes" -B "$BUILD_DIR/libunwind" \
+    -DCMAKE_BUILD_TYPE=Release \
+    -DCMAKE_C_COMPILER="$CC" \
+    -DCMAKE_CXX_COMPILER="$CXX" \
+    -DCMAKE_C_FLAGS="--target=aarch64-linux-ohos --sysroot=$OHOS_SYSROOT -D__MUSL__ -D__OHOS__ -nostdinc++ -I$LLVM_PREFIX/include/aarch64-linux-ohos/c++/v1" \
+    -DCMAKE_CXX_FLAGS="--target=aarch64-linux-ohos --sysroot=$OHOS_SYSROOT -D__MUSL__ -D__OHOS__ -nostdinc++ -I$LLVM_PREFIX/include/aarch64-linux-ohos/c++/v1" \
+    -DLLVM_ENABLE_RUNTIMES="libunwind" \
+    -DLIBUNWIND_USE_COMPILER_RT=ON \
+    -DCMAKE_INSTALL_PREFIX="$CROSS/libunwind" \
+    -DCMAKE_TRY_COMPILE_TARGET_TYPE=STATIC_LIBRARY
+  ninja -C "$BUILD_DIR/libunwind" install -j"$NINJA_JOBS"
+
+  # Stage 2: libcxx + libcxxabi + libunwind with __n1 ABI
+  echo "=== Stage 2: libcxx + libcxxabi with -DLIBCXX_ABI_NAMESPACE=__n1 ==="
+  cmake -G Ninja -S "$LLVM_SRC/runtimes" -B "$BUILD_DIR/libcxx" \
+    -DCMAKE_BUILD_TYPE=Release \
+    -DCMAKE_C_COMPILER="$CC" \
+    -DCMAKE_CXX_COMPILER="$CXX" \
+    -DCMAKE_C_FLAGS="--target=aarch64-linux-ohos --sysroot=$OHOS_SYSROOT -D__MUSL__ -D__OHOS__ -D_LIBCPP_PROVIDES_DEFAULT_RUNE_TABLE -D_LIBCPP_HAS_NO_LOCALIZATION -nostdinc++ -I$CROSS/libunwind/include/c++/v1" \
+    -DCMAKE_CXX_FLAGS="--target=aarch64-linux-ohos --sysroot=$OHOS_SYSROOT -D__MUSL__ -D__OHOS__ -D_LIBCPP_PROVIDES_DEFAULT_RUNE_TABLE -D_LIBCPP_HAS_NO_LOCALIZATION -nostdinc++ -I$CROSS/libunwind/include/c++/v1" \
+    -DLLVM_ENABLE_RUNTIMES="libcxx;libcxxabi;libunwind" \
+    -DLIBCXX_ABI_NAMESPACE=__n1 \
+    -DLIBCXX_ENABLE_SHARED=OFF \
+    -DLIBCXXABI_ENABLE_SHARED=OFF \
+    -DLIBUNWIND_ENABLE_SHARED=OFF \
+    -DLIBCXX_USE_COMPILER_RT=ON \
+    -DLIBCXXABI_USE_COMPILER_RT=ON \
+    -DLIBUNWIND_USE_COMPILER_RT=ON \
+    -DLIBCXX_LIBDIR_SUFFIX="" \
+    -DCMAKE_INSTALL_PREFIX="$CROSS" \
+    -DCMAKE_TRY_COMPILE_TARGET_TYPE=STATIC_LIBRARY
+  ninja -C "$BUILD_DIR/libcxx" install -j"$NINJA_JOBS"
+
+  # Restore llvm@21 cmake config
+  if [ -d "${LLVM_CMAKE_DIR}.bak" ]; then
+    mv "${LLVM_CMAKE_DIR}.bak" "$LLVM_CMAKE_DIR"
+    echo "=== restored llvm@21 cmake config ==="
+  fi
+
+  # Symlink into the layout flags.ts expects.
+  # cmake installs headers to $CROSS/include/c++/v1/ and libs to $CROSS/lib/.
+  # flags.ts reads $CROSS/libcxx/include/v1/ and $CROSS/libcxx/lib/libc++.a.
+  mkdir -p "$CROSS/libcxx/include" "$CROSS/libcxxabi/include" \
+           "$CROSS/libcxx/lib" "$CROSS/libcxxabi/lib" "$CROSS/libunwind/lib"
+  ln -sfn "$CROSS/include/c++/v1" "$CROSS/libcxx/include/v1"
+  ln -sfn "$CROSS/include/c++/v1" "$CROSS/libcxxabi/include/v1"
+  ln -sfn "$CROSS/lib/libc++.a"      "$CROSS/libcxx/lib/libc++.a"
+  ln -sfn "$CROSS/lib/libc++abi.a"   "$CROSS/libcxxabi/lib/libc++abi.a"
+  ln -sfn "$CROSS/lib/libunwind.a"   "$CROSS/libunwind/lib/libunwind.a"
+
+  echo "=== verifying headers exist ==="
+  ls "$CROSS/libcxx/include/v1/cstddef" "$CROSS/libcxx/include/v1/__config_site" 2>/dev/null || {
+    echo "ERROR: libcxx headers not at $CROSS/libcxx/include/v1/"
+    echo "  $CROSS/include/ contents:"; ls "$CROSS/include/" 2>/dev/null | head -10
+    echo "  $CROSS/include/c++/ contents:"; ls "$CROSS/include/c++/" 2>/dev/null | head -10
+    exit 1
+  }
+  grep '_LIBCPP_ABI_NAMESPACE' "$CROSS/libcxx/include/v1/__config_site"
+
+  # Patch __config_site: add musl compatibility defines so all downstream
+  # consumers (WebKit, bun C++, etc.) get them automatically via the header.
+  CONFIG_SITE="$CROSS/libcxx/include/v1/__config_site"
+  if ! grep -q '_LIBCPP_PROVIDES_DEFAULT_RUNE_TABLE' "$CONFIG_SITE"; then
+    echo '#define _LIBCPP_PROVIDES_DEFAULT_RUNE_TABLE' >> "$CONFIG_SITE"
+    echo '#define _LIBCPP_HAS_NO_LOCALIZATION' >> "$CONFIG_SITE"
+    echo "=== patched __config_site: added musl compat defines ==="
+  fi
+
+  # Self-check: verify __n1 symbols present, __h absent
+  echo "=== verifying __n1 ABI ==="
+  NM="$LLVM_PREFIX/bin/llvm-nm"
+  for lib in libc++.a libc++abi.a; do
+    n1=$("$NM" "$CROSS/lib/$lib" 2>/dev/null | grep -c '__n1' || true)
+    h_sym=$("$NM" "$CROSS/lib/$lib" 2>/dev/null | grep -c '__h' || true)
+    echo "  $lib: __n1=$n1 __h=$h_sym"
+    [ "$n1" -gt 0 ] || { echo "ERROR: $lib has no __n1 symbols"; exit 1; }
+  done
+
+  touch "$LIBCXX_N1_STAMP"
+  echo "=== cross-libs OK (ABI __n1, self-compiled from LLVM 21.1.8) ==="
+
+  # Cleanup build artifacts to save cache space
+  rm -rf "$BUILD_DIR" /tmp/llvm-project-src "/tmp/${LLVM_SRC_TARBALL}"
+fi
+
+# ── Scaffold ohos-icu (bun.rb lines 119-135) ───────────────────────────
+# config.ts:1013 defaults ohosIcuDir=<cwd>/build/ohos-icu/target;
+# webkit.ts:472 resolves hostBin=<ohosIcuDir>/../host/bin for ICU data tools
+# (genrb/genccode/gencmn/pkgdata) — WebKit CMake needs these under
+# --webkit=local (from-source WebKit, not the bun-webkit bottle).
+ICU_TARGET=build/ohos-icu/target
+ICU_HOST=build/ohos-icu/host
+mkdir -p "$ICU_TARGET/include" "$ICU_TARGET/lib" "$ICU_HOST/bin"
+ln -sf "$ICU_PREFIX/include/unicode" "$ICU_TARGET/include/unicode"
+for a in libicudata.a libicui18n.a libicuuc.a; do
+  ln -sf "$ICU_PREFIX/lib/$a" "$ICU_TARGET/lib/$a"
+done
+for t in genrb genccode gencmn pkgdata; do
+  [ -x "$ICU_PREFIX/bin/$t" ] && ln -sf "$ICU_PREFIX/bin/$t" "$ICU_HOST/bin/$t" || true
+done
+echo "=== ohos-icu OK (from icu4c@78) ==="
+
+# ── Configure (webkit=local, --configure-only) ────────────────────────
+echo "=== configure (webkit=local, --configure-only) ==="
+"$BUN_BOOT_DIR/bun" scripts/build.ts \
+  --profile=release \
+  --os=ohos \
+  --arch=aarch64 \
+  --webkit=local \
+  --build-dir=build/release-ohos \
+  --ohos-sdk-root="$OHOS_SDK_ROOT" \
+  --ohos-sysroot="$OHOS_SYSROOT" \
+  --configure-only 2>&1 | tee /tmp/build.log
+
+# ── Generate WebKit build.ninja ───────────────────────────────────────
+echo "=== configure-WebKit ==="
+ninja -C build/release-ohos configure-WebKit -j1 2>&1 | tee -a /tmp/build.log
+
+# WebKit CMake FindThreads bug: -lpthreads → -lpthread. Universal (not
+# llvm-22-specific); the from-source WebKit build under --webkit=local hits it.
+if [ -f build/release-ohos/deps/WebKit/build.ninja ]; then
+  sed -i 's/-lpthreads/-lpthread/g' build/release-ohos/deps/WebKit/build.ninja
+fi
+
+# ── Build ─────────────────────────────────────────────────────────────
+echo "=== build (ninja bun, -j${NINJA_JOBS}) ==="
+set +e
+ninja -C build/release-ohos bun -j"${NINJA_JOBS}" 2>&1 | tee -a /tmp/build.log
+rc=${PIPESTATUS[0]}
+set -e
+if [ "$rc" -ne 0 ]; then
+  echo "=== build failed (rc=$rc) ==="
+  grep -inE 'error\[|error:|fatal error|undefined reference|ld: error|FAILED:' /tmp/build.log | head -50 || true
+  tail -80 /tmp/build.log || true
+  exit 1
+fi
+
+echo "=== build OK ==="
+OUT=build/release-ohos/bun
+[ -f "$OUT" ] || OUT=build/release-ohos/bun-profile
+ls -lh "$OUT"
diff --git a/.github/workflows/README.md b/.github/workflows/README.md
new file mode 100644
index 00000000000..f101b23887e
--- /dev/null
+++ b/.github/workflows/README.md
@@ -0,0 +1,36 @@
+# OHOS CI 职责索引
+
+> 交付线 ohos-aarch64 的 workflow 一页地图；新增/改动/删除 lane 时同步本表。
+> 上游（oven-sh/bun）继承的 workflow 不列于此——文件保持原样以减少上游合并
+> 冲突；在本 fork 永不生效的上游 lane（comment-cop、buildkite 取消器、上游
+> release 机器、issue 机器人、find-issues）应在仓库设置层禁用（Actions →
+> 选中 workflow → ⋯ → Disable workflow），不改文件。
+
+## 活跃 lane
+
+| Workflow | 职责 | 触发 | 产物 |
+|---|---|---|---|
+| `ohos-build-github.yml` | 权威构建：容器通道全量构建（GitHub 托管 ARM）+ 预签（ohos-selfsign + verify 门禁） | push / PR 到交付分支；任意 tag push（排除滚动 tag） | `ohos-latest`（签名 tar.gz + unsigned）、`latest`（5 平台 + OHOS tar.gz/unsigned）、**tag push → 版本化 release（6 产物，页面自动生成）**；统一页面布局，占位文档自动播种到 release-docs |
+| `ohos-build-rust.yml` | 快速反馈：自托管增量 Rust 构建（sccache） | push/PR 命中 Rust 源码路径 | 无（仅构建校验） |
+| `ohos-brew-deps-canary.yml` | 漂移哨兵：浮动 tap tip 日常验收 | 每日 cron | 运行结论：tip 可消费（打印 bump SHA）/ 不可消费（warning，保持 OHOS_CORE_PIN）；红 = 评估本身失败 |
+| `ohos-container-test.yml` | 容器内 JS 测试集（无设备，全 GitHub 托管） | 手动 / 本文件变更 | results.json（`--test-filter` 支持部分跑） |
+| `ohos-full-test.yml` | 两段式：自托管构建 → 容器测试 | 手动 / 本文件变更 | 测试报告 |
+
+上游 lane 中在本 fork 实际工作的：format（autofix.ci）、lint、rust-lints、
+source-lints、bun-types、auto-label。
+
+## 已删除（2026-09-23，均从未运行过）
+
+| Workflow | 淘汰原因 |
+|---|---|
+| `ohos-release.yml` | 版本发布通道（自托管构建，2026-09-24 退役）：自托管设备不存在，run 永远排队；版本发布改由 `ohos-build-github.yml` 的 tag 触发路径承载（容器构建 + 同构 6 产物 + 自动页面） |
+| `ohos-build.yml` | 最早的交叉编译构建，早已显式禁用；被容器通道取代 |
+| `ohos-build-incremental.yml` | "1-3 分钟增量构建"设想，仅手动触发且从未跑过；被 `ohos-build-rust.yml` 取代 |
+| `ohos-full-release.yml` | 构建到共享目录的发布设想（触发 tag 从未推送）；tag 发布流已覆盖该需求 |
+
+## 定时任务语义约定
+
+红 = 需要有人处理；常态化的"无动作结论"一律绿 + warning（先例：canary 的
+"浮动 tip 不可消费 → 保持 pin"）。测试 lane 的每周定时已移除——full-test
+的自托管构建 job 曾在定时触发时等 runner 24 小时，container-test 以 5 个
+排除跑全量集、在移植线已知失败基线清零前是结构性红；两者保留手动 dispatch。
diff --git a/.github/workflows/build-x86.yml b/.github/workflows/build-x86.yml
new file mode 100644
index 00000000000..8f7d3dde8e7
--- /dev/null
+++ b/.github/workflows/build-x86.yml
@@ -0,0 +1,222 @@
+# Standard x86_64 / arm64 Bun builds on GitHub-hosted runners (no OHOS, no
+# Buildkite). This is the non-OHOS leg of the "unified CI matrix":
+#   linux-x64   -> ubuntu-24.04         (x86_64 GNU)
+#   windows-x64 -> windows-2025         (x86_64 MSVC, native)
+#   linux-arm64 -> ubuntu-24.04-arm     (aarch64 GNU, optional 4th leg)
+#
+# The OHOS aarch64 build lives in ohos-build-github.yml and is NOT touched
+# here. This workflow only builds the stock oven-sh/bun targets that the
+# upstream produces in Buildkite (see .buildkite/ci.mjs). We use GitHub's
+# native runners instead — no OHOS toolchain, no social4hyq container.
+#
+# Build strategy: `--profile=release` (webkit=prebuilt, lto=false, native
+# host target). The release profile resolves target os/arch from the host,
+# so on ubuntu-24.04 it produces a linux-x64 `bun` ELF and on windows-2025
+# a windows-x64 `bun.exe` PE. WebKit is fetched as a prebuilt tarball from
+# oven-sh/WebKit GitHub releases (scripts/build/deps/webkit.ts prebuiltUrl),
+# so we never compile WebKit from source — keeps the run under ~20min.
+#
+# Toolchain: LLVM 21 (apt.llvm.org on linux, chocolatey on windows) to match
+# the LLVM_VERSION_RANGE ">=21.1.0 <23.0.0" enforced by tools.ts. Rust
+# nightly-2026-07-20 matches rust-toolchain.toml. Bun for codegen comes from
+# the repo's own setup-bun action. On Windows, build.ts auto re-execs into
+# the VS dev shell (vs-shell.ps1) for cl.exe/mt.exe/rc.exe paths.
+
+name: Build Bun (x86/arm64, github-hosted)
+
+on:
+  workflow_dispatch:
+
+concurrency:
+  group: build-x86-${{ github.ref }}
+  cancel-in-progress: true
+
+env:
+  RUST_TOOLCHAIN: nightly-2026-07-20
+  # Match the Dockerfile: pin CC/CXX so configure picks the freshly-installed
+  # clang-21 over whatever older clang the runner image ships.
+  CC: clang
+  CXX: clang++
+
+jobs:
+  build:
+    name: Build Bun ${{ matrix.label }}
+    runs-on: ${{ matrix.runner }}
+    timeout-minutes: 90
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - label: linux-x64
+            runner: ubuntu-24.04
+            exe: bun
+            build-dir: build/release-x86-linux-x64
+          - label: windows-x64
+            runner: windows-2025
+            exe: bun.exe
+            build-dir: build/release-x86-windows-x64
+          - label: linux-arm64
+            runner: ubuntu-24.04-arm
+            exe: bun
+            build-dir: build/release-x86-linux-arm64
+
+    steps:
+      - name: Checkout Bun source
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      # ── Linux toolchain ────────────────────────────────────────────────
+      # ubuntu-latest / ubuntu-24.04-arm ship cmake + ninja + clang, but the
+      # clang is typically older than the 21.1 floor tools.ts enforces, so
+      # install LLVM 21 from apt.llvm.org (same script the Dockerfile uses).
+      - name: Install LLVM 21 + build tools (linux)
+        if: runner.os == 'Linux'
+        run: |
+          set -e
+          sudo apt-get update -qq
+          sudo apt-get install -y -qq --no-install-recommends \
+            ninja-build cmake build-essential git curl wget gnupg lsb-release \
+            libxml2-dev nasm pkg-config
+          # apt.llvm.org installer: ./llvm.sh 21 all  (clones clang, lld, llvm tools)
+          wget -qO /tmp/llvm.sh https://apt.llvm.org/llvm.sh
+          chmod +x /tmp/llvm.sh
+          sudo /tmp/llvm.sh 21 || { echo "llvm.sh failed"; exit 1; }
+          # Surface clang-21 / lld-21 as the unversioned names configure looks for.
+          for t in clang clang++ lld ld.lld llvm-ar llvm-ranlib llvm-strip llvm-objcopy; do
+            sudo ln -sf "/usr/bin/$t-21" "/usr/bin/$t"
+          done
+          sudo ln -sf /usr/bin/clang-21 /usr/bin/cc
+          sudo ln -sf /usr/bin/clang++-21 /usr/bin/c++
+          clang --version | head -1
+          cmake --version | head -1
+          ninja --version
+
+      # ── Windows toolchain ──────────────────────────────────────────────
+      # windows-2025 ships VS 2022 (build.ts finds it via vs-shell.ps1),
+      # cmake, ninja, and Strawberry perl. LLVM is preinstalled on the image
+      # but its version drifts below the 21.1 floor tools.ts enforces, so
+      # install the latest chocolatey LLVM (22.1.7 at writing — within the
+      # >=21.1.0 <23.0.0 range). nasm is needed for BoringSSL win-x64 asm.
+      - name: Install LLVM + nasm (windows)
+        if: runner.os == 'Windows'
+        shell: pwsh
+        run: |
+          choco install -y --no-progress llvm
+          # nasm: BoringSSL's win-x64 assembly is NASM syntax (config.ts).
+          choco install -y --no-progress nasm
+          # Put LLVM on PATH for configure. The chocolatey install lands in
+          # C:\Program Files\LLVM\bin — add it ahead of the preinstalled LLVM.
+          echo "C:\Program Files\LLVM\bin" >> $env:GITHUB_PATH
+          clang --version | Select-Object -First 1
+          cmake --version | Select-Object -First 1
+          ninja --version
+
+      # ── Rust (both) ────────────────────────────────────────────────────
+      # rust-toolchain.toml pins nightly-2026-07-20 + the cross-target list.
+      # We install with the host target only (the release profile builds
+      # native), which is faster than pulling every Tier 2 target's std.
+      - name: Install Rust nightly
+        uses: dtolnay/rust-toolchain@stable
+        with:
+          toolchain: ${{ env.RUST_TOOLCHAIN }}
+
+      - name: Print rustc / cargo
+        shell: bash
+        run: |
+          rustc --version
+          cargo --version
+          rustc --print sysroot
+
+      # ── Bun (codegen runtime) ──────────────────────────────────────────
+      # configure.ts findBun() needs bun for `bun install` + codegen scripts.
+      # The repo's setup-bun action pulls a released bun for the host arch.
+      - name: Setup Bun (codegen)
+        uses: ./.github/actions/setup-bun
+        with:
+          bun-version: latest
+
+      - name: bun install (root)
+        shell: bash
+        run: |
+          bun --version
+          bun install --frozen-lockfile 2>&1 | tail -20 || bun install 2>&1 | tail -20
+
+      - name: bun install (src/node-fallbacks)
+        shell: bash
+        run: |
+          cd src/node-fallbacks
+          bun install --frozen-lockfile 2>&1 | tail -20 || bun install 2>&1 | tail -20
+
+      # ── Build ──────────────────────────────────────────────────────────
+      # release profile: buildType=Release, webkit=prebuilt, lto=false.
+      # Native target — no --os/--arch override; configure derives from host.
+      - name: Configure + build Bun
+        shell: bash
+        run: |
+          set -eo pipefail
+          echo "=== toolchain ==="
+          clang --version | head -1
+          echo "=== build:release (webkit=prebuilt, native) ==="
+          bun scripts/build.ts \
+            --profile=release \
+            --build-dir=${{ matrix.build-dir }} 2>&1 | tee build.log; rc=$?
+          if [ "$rc" -ne 0 ]; then
+            echo "=== build failed (rc=$rc) — first errors ==="
+            grep -inE "error\[|error:|fatal error|undefined reference|ld: error|collect2:|cannot find|FAILED:|panic|not found|missing" build.log | head -50 || true
+            echo "=== last 80 lines ==="
+            tail -80 build.log || true
+            exit 1
+          fi
+          echo "=== build OK ==="
+
+      # ── Verify ─────────────────────────────────────────────────────────
+      - name: Verify binary
+        shell: bash
+        run: |
+          set -e
+          OUT="${{ matrix.build-dir }}/${{ matrix.exe }}"
+          # Fallback: some profiles name the output bun-profile(.exe).
+          [ -f "$OUT" ] || OUT="${{ matrix.build-dir }}/bun-profile${{ runner.os == 'Windows' && '.exe' || '' }}"
+          [ -f "$OUT" ] || { echo "ERROR: binary not found at $OUT"; ls -la "${{ matrix.build-dir }}"; exit 1; }
+          echo "=== binary ==="
+          ls -lh "$OUT"
+          file "$OUT" || true
+          if [ "${{ runner.os }}" = "Linux" ]; then
+            file "$OUT" | grep -iqE "ELF.*(x86-64|aarch64|ARM aarch64)" || { echo "ERROR: not an ELF for expected arch"; exit 1; }
+            echo "=== ELF header ==="
+            readelf -h "$OUT" 2>/dev/null | head -20 || true
+            echo "=== NEEDED libs ==="
+            readelf -d "$OUT" 2>/dev/null | grep NEEDED || true
+          else
+            file "$OUT" | grep -iqE "PE32|MS-DOS|Windows" || { echo "ERROR: not a Windows PE"; exit 1; }
+          fi
+          echo "=== validation OK ==="
+
+      - name: Dump failure diagnostics
+        if: failure()
+        shell: bash
+        run: |
+          echo "=== build dir ==="; ls -la "${{ matrix.build-dir }}" 2>&1 | head -30 || true
+          echo "=== first 80 error lines from build.log ==="
+          grep -inE "error\[|error:|fatal error|undefined reference|ld: error|collect2:|cannot find|FAILED:|panic|not found|missing" build.log 2>/dev/null | head -80 || true
+          echo "=== last 120 lines of build.log ==="
+          tail -120 build.log 2>/dev/null || true
+
+      - name: Upload binary
+        if: success()
+        uses: actions/upload-artifact@v4
+        with:
+          name: bun-${{ matrix.label }}
+          path: ${{ matrix.build-dir }}/${{ matrix.exe }}
+          if-no-files-found: warn
+          retention-days: 14
+
+      - name: Upload build log
+        if: failure()
+        uses: actions/upload-artifact@v4
+        with:
+          name: build-log-${{ matrix.label }}
+          path: build.log
+          if-no-files-found: ignore
+          retention-days: 7
diff --git a/.github/workflows/cross-x86.yml b/.github/workflows/cross-x86.yml
new file mode 100644
index 00000000000..65ebe008721
--- /dev/null
+++ b/.github/workflows/cross-x86.yml
@@ -0,0 +1,424 @@
+# Cross-compile Bun for foreign targets on an aarch64 Linux host (no image, no
+# bake). Spike / pilot — runs alongside build-x86.yml's native legs; green +
+# verified they can replace those legs later.
+#
+# Host: ubuntu-24.04-arm (aarch64, pinned — not *-latest).
+# Targets:
+#   - windows-x64 (x86_64-pc-windows-msvc) — green since cc18f4f.
+#   - linux-x64   (x86_64-unknown-linux-gnu) — added in this iteration.
+#     Needs the upstream config.ts linux-gnu cross block (detectLinuxGlibcSysroot
+#     + the `if (linux && abi !== "android" && crossTarget === undefined)` block)
+#     cherry-picked into this branch (see ohos-cross-compile-linux-win.md §3.1),
+#     AND a ubuntu:20.04 glibc 2.31 + gcc-13 libstdc++ sysroot at
+#     /opt/linux-sysroot-glibc (provisioned inline per-run — see the
+#     "Install linux-x64 sysroot" step, mirroring
+#     bootstrap.sh::install_linux_glibc_sysroot).
+#   - darwin-arm64 (arm64-apple-macosx) — net-new lane, no macOS runner needed.
+#     clang --target=arm64-apple-macosx + -isysroot <SDK> + ld64.lld (lld's
+#     Mach-O port). The macOS SDK (MacOSX26.5.sdk, ~60MB) is fetched at
+#     configure time by the vendored xmac tool (scripts/build/xmac.mjs) from
+#     Apple's public software-update CDN — same model as xwin for Windows, not
+#     baked into any image (Apple SDK license). xmac needs `xz` on PATH. Rust
+#     aarch64-apple-darwin (Tier 2 prebuilt std). WebKit prebuilt
+#     bun-webkit-macos-arm64-lto.tar.gz. ThinLTO defaults ON for darwin cross
+#     (config.ts ltoDefault covers `darwinCross`). No source changes expected —
+#     the fork already carries the full darwin cross path (config.ts 1186-1228,
+#     macos-sdk.ts, rust.ts, xmac.mjs). See ohos-cross-compile-darwin-arm64.md.
+#
+# Toolchain: installed fresh each run (no container image). This is slower
+# than a baked image but proves the pipeline end-to-end with no image-
+# maintenance overhead.
+#   - LLVM 21 from apt.llvm.org (arm64 packages exist for noble) provides
+#     clang / clang++ / lld / llvm-ar plus clang-cl / lld-link / llvm-lib /
+#     llvm-rc / llvm-objdump for the windows leg, ld64.lld + dsymutil for the
+#     darwin leg. tools.ts picks these by TARGET os regardless of host.
+#   - Rust nightly-2026-07-20 (matches rust-toolchain.toml) + the per-leg
+#     rust target + rust-src (for -Zbuild-std on Tier 3 edge cases —
+#     harmless if unused).
+#   - windows-x64: xwin sysroot fetched on demand at configure time by
+#     winsysroot.ts::ensureWindowsSysroot() into cacheDir/winsysroot. xwin
+#     0.9.0 ships an aarch64-unknown-linux-musl binary, so it runs natively
+#     on the aarch64 host. SDK/CRT versions pinned in winsysroot.ts
+#     (10.0.26100 / 14.44.17.14) — do NOT override here.
+#   - linux-x64: sysroot built inline (skopeo ubuntu:20.04 rootfs + dpkg-deb
+#     libc6-dev etc. + oven-sh/WebKit gcc-13 libstdc++ debs). The
+#     --wrap list in flags.ts covers the 2.31 -> 2.17 tail, so the binary
+#     stays glibc-2.17 portable.
+#   - darwin-arm64: macOS SDK fetched at configure time by xmac.mjs (pin
+#     MACOS_SDK_VERSION = "26.5" in macos-sdk.ts). ld64.lld + llvm-strip +
+#     dsymutil come from the same LLVM 21 install.
+#
+# Source changes on this branch:
+#   - config.ts: cherry-picked the linux-gnu/musl cross block + detect
+#     helpers + PartialConfig.linuxSysroot field from oven-sh/bun main
+#     (verbatim — see ohos-cross-compile-linux-win.md §3.1).
+#   - NodeSqlite.h / NodeVM.h / JSWrappingFunction.h: qualify
+#     DestructionMode enumerators (needed by clang-cl on the windows leg;
+#     see ohos-cross-compile-windows-x64-spike.md iter 2).
+#   - darwin-arm64: NO source changes — the darwin cross path is already in
+#     the fork (config.ts, macos-sdk.ts, rust.ts, xmac.mjs).
+#
+# ThinLTO: linux gnu cross defaults to ON (config.ts ltoDefault covers
+# `linux || darwinCross`). darwin-arm64 cross also defaults to ON (same
+# ltoDefault branch — `darwinCross` is set when host.os != "darwin").
+# windows-x64 stays OFF (LLVM ThinLTO miscompile on x86-64 JSC). Do not add
+# --lto=on to the windows leg.
+
+name: Cross-compile Bun (aarch64 host)
+
+on:
+  workflow_dispatch:
+  workflow_call:
+    inputs:
+      sha:
+        description: 'Commit to build (defaults to the triggering ref)'
+        required: false
+        type: string
+
+concurrency:
+  group: cross-x86-${{ inputs.sha || github.ref }}
+  cancel-in-progress: true
+
+env:
+  RUST_TOOLCHAIN: nightly-2026-07-20
+  # Pin CC/CXX so configure picks the freshly-installed clang-21 over
+  # whatever older clang the runner image ships. Note: these are the HOST
+  # compiler for build-time codegen tools; the target compiler is selected
+  # by tools.ts based on target os (clang for linux, clang-cl for windows,
+  # clang --target=*-apple-macosx for darwin), NOT by CC.
+  CC: clang
+  CXX: clang++
+
+jobs:
+  build:
+    name: cross ${{ matrix.label }}
+    runs-on: ubuntu-24.04-arm
+    timeout-minutes: 90
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - label: linux-x64
+            os: linux
+            arch: x64
+            abi: gnu
+            exe: bun
+            build-dir: build/cross-linux-x64
+            rust-target: x86_64-unknown-linux-gnu
+          # linux-arm64 on the aarch64 host is a native build (host == target):
+          # no sysroot, no cross flags — included for release parity with the
+          # reference delivery line's five-product rolling release.
+          - label: linux-arm64
+            os: linux
+            arch: aarch64
+            abi: gnu
+            exe: bun
+            build-dir: build/cross-linux-arm64
+            rust-target: aarch64-unknown-linux-gnu
+          - label: windows-x64
+            os: windows
+            arch: x64
+            abi: ""
+            exe: bun.exe
+            build-dir: build/cross-windows-x64
+            rust-target: x86_64-pc-windows-msvc
+          # darwin-arm64: arm64-apple-macosx. macOS SDK fetched at configure
+          # time by xmac.mjs (Apple CDN, ~60MB). ld64.lld + llvm-strip +
+          # dsymutil from LLVM 21. Rust aarch64-apple-darwin (Tier 2 prebuilt
+          # std). WebKit prebuilt bun-webkit-macos-arm64-lto.tar.gz. ThinLTO
+          # defaults ON for darwinCross. No source changes — the fork already
+          # carries the full darwin cross path (config.ts 1186-1228).
+          - label: darwin-arm64
+            os: darwin
+            arch: aarch64
+            abi: ""
+            exe: bun
+            build-dir: build/cross-darwin-arm64
+            rust-target: aarch64-apple-darwin
+
+    steps:
+      - name: Checkout Bun source
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+          ref: ${{ inputs.sha || github.event.pull_request.head.sha || github.ref }}
+
+      # ── Host toolchain: LLVM 21 + build tools ──────────────────────────
+      # ubuntu-24.04-arm ships an older clang; tools.ts enforces
+      # LLVM_VERSION_RANGE ">=21.1.0 <23.0.0", so install LLVM 21 from
+      # apt.llvm.org (arm64 noble packages confirmed). `all` pulls clang-cl,
+      # lld-link, llvm-lib, llvm-rc, llvm-objdump as part of clang-21/lld-21.
+      # lld-21 also ships ld64.lld-21 (lld's Mach-O port, needed for the
+      # darwin leg) and llvm-21 ships dsymutil-21 + llvm-strip-21.
+      # binutils-x86-64-linux-gnu provides /usr/bin/x86_64-linux-gnu-strip
+      # (GNU strip that fully handles -R .eh_frame on x86-64 ELF; the host's
+      # aarch64 strip rejects foreign-arch ELF). config.ts's cross strip
+      # block prefers it over llvm-strip when present.
+      # xz-utils: required by xmac.mjs to extract the macOS SDK .pkg payload
+      # (darwin leg only; harmless for the other legs).
+      - name: Install LLVM 21 + build tools
+        run: |
+          set -e
+          sudo apt-get update -qq
+          sudo apt-get install -y -qq --no-install-recommends \
+            ninja-build cmake build-essential git curl wget gnupg lsb-release \
+            libxml2-dev nasm pkg-config file binutils \
+            binutils-x86-64-linux-gnu xz-utils
+          wget -qO /tmp/llvm.sh https://apt.llvm.org/llvm.sh
+          chmod +x /tmp/llvm.sh
+          sudo /tmp/llvm.sh 21 || { echo "llvm.sh failed"; exit 1; }
+          # Surface the -21 binaries as the unversioned names tools.ts's
+          # findLlvmTool() looks for (it searches PATH for "clang", "clang-cl",
+          # "lld-link", "llvm-lib", "llvm-rc", "llvm-objdump", ...). The
+          # clang-21 deb ships clang-cl-21; symlink the MSVC drivers too.
+          # ld64.lld + dsymutil are darwin-cross-only (lld's Mach-O port and
+          # the DWARF dSYM tool) — symlinking them is harmless on the other
+          # legs (tools.ts only resolves them when the target is darwin).
+          for t in clang clang++ lld ld.lld ld64.lld llvm-ar llvm-ranlib \
+                   llvm-strip llvm-objcopy llvm-objdump llvm-readelf \
+                   clang-cl lld-link llvm-lib llvm-rc llvm-mt dsymutil; do
+            sudo ln -sf "/usr/bin/$t-21" "/usr/bin/$t"
+          done
+          sudo ln -sf /usr/bin/clang-21 /usr/bin/cc
+          sudo ln -sf /usr/bin/clang++-21 /usr/bin/c++
+          echo "=== versions ==="
+          clang --version | head -1
+          clang-cl --version 2>&1 | head -1 || true
+          lld-link --version 2>&1 | head -1 || true
+          ld64.lld --version 2>&1 | head -1 || true
+          dsymutil --version 2>&1 | head -1 || true
+          cmake --version | head -1
+          ninja --version
+
+      # ── Rust ───────────────────────────────────────────────────────────
+      # rust-toolchain.toml pins nightly-2026-07-20. Install with the
+      # per-leg target + rust-src. rust.ts rustCanCrossFromLinux returns
+      # true for linux (all arches), windows (when a winsysroot is present),
+      # and darwin (Tier 2 prebuilt std — a staticlib needs no Mach-O link).
+      - name: Install Rust nightly
+        uses: dtolnay/rust-toolchain@4cda84d5c5c54efe2404f9d843567869ab1699d4
+        with:
+          toolchain: ${{ env.RUST_TOOLCHAIN }}
+          targets: ${{ matrix.rust-target }}
+          components: rust-src
+
+      - name: Print rustc / cargo
+        run: |
+          rustc --version
+          cargo --version
+          rustc --print sysroot
+          rustup target list --installed
+
+      # ── Bun (codegen runtime) ──────────────────────────────────────────
+      # configure.ts findBun() needs bun for `bun install` + codegen. The
+      # repo's setup-bun action pulls a released linux-aarch64 bun (host
+      # arch). The windows setup-bun path bug (build-x86.yml) does NOT
+      # trigger — we're on a linux host.
+      - name: Setup Bun (codegen)
+        uses: ./.github/actions/setup-bun
+        with:
+          bun-version: latest
+
+      - name: bun install (root)
+        run: |
+          bun --version
+          bun install --frozen-lockfile 2>&1 | tail -20 || bun install 2>&1 | tail -20
+
+      - name: bun install (src/node-fallbacks)
+        run: |
+          cd src/node-fallbacks
+          bun install --frozen-lockfile 2>&1 | tail -20 || bun install 2>&1 | tail -20
+
+      # ── linux-x64 sysroot (only linux leg) ────────────────────────────
+      # Provision /opt/linux-sysroot-glibc: ubuntu:20.04 rootfs (glibc 2.31)
+      # + libc6-dev/linux-libc-dev/libcrypt-dev debs + oven-sh/WebKit gcc-13
+      # libstdc++ debs. Mirrors bootstrap.sh::install_linux_glibc_sysroot
+      # (scripts/bootstrap.sh 1445-1543) — see ohos-cross-compile-linux-win.md
+      # §2.3 / appendix A. detectLinuxGlibcSysroot() in config.ts finds it by
+      # the default path; no env var needed. Skopeo pulls the amd64 image even
+      # on this aarch64 host (--override-arch amd64). The --wrap list in
+      # flags.ts (1237-1296) covers 2.31 -> 2.17 so the binary stays portable.
+      - name: Install linux-x64 sysroot
+        # x64 leg only: the provisioned rootfs is amd64. The linux-arm64 leg
+        # is a native build (host == target) and compiles against the host's
+        # own aarch64 glibc — pointing it at this sysroot fails with
+        # "bits/libc-header-start.h file not found".
+        if: matrix.os == 'linux' && matrix.arch == 'x64'
+        run: |
+          set -eo pipefail
+          SYSROOT="/opt/linux-sysroot-glibc"
+          if [ -d "$SYSROOT/usr/include/c++/13" ] && [ -f "$SYSROOT/usr/include/features.h" ]; then
+            echo "sysroot already present at $SYSROOT"
+            exit 0
+          fi
+          echo "=== provisioning $SYSROOT (ubuntu:20.04 glibc 2.31 + gcc-13 libstdc++) ==="
+          sudo apt-get install -y -qq --no-install-recommends skopeo jq binutils
+          sudo rm -rf "$SYSROOT"
+          sudo mkdir -p "$SYSROOT"
+          TMP="$(mktemp -d)"
+          mkdir -p "$TMP/img"
+          # 1. ubuntu:20.04 rootfs (glibc 2.31 runtime libs).
+          skopeo copy --override-arch amd64 \
+            docker://docker.io/library/ubuntu:20.04 "dir:$TMP/img"
+          for d in $(jq -r '.layers[].digest' "$TMP/img/manifest.json" | sed 's/^sha256://'); do
+            # Raw tar so mknod failures on /dev nodes don't abort; the libc6
+            # deb below provides the files we actually need.
+            sudo tar -xzf "$TMP/img/$d" -C "$SYSROOT" 2>/dev/null || true
+          done
+          # 2. focal runtime + dev headers.
+          APT_BASE="http://archive.ubuntu.com/ubuntu"
+          curl -sL "$APT_BASE/dists/focal-updates/main/binary-amd64/Packages.gz" -o "$TMP/Packages1.gz"
+          curl -sL "$APT_BASE/dists/focal/main/binary-amd64/Packages.gz" -o "$TMP/Packages2.gz"
+          # focal-updates first so awk's first-match picks the patched version.
+          gzip -dc "$TMP/Packages1.gz" "$TMP/Packages2.gz" > "$TMP/Packages"
+          for pkg in libc6 libc6-dev linux-libc-dev libcrypt1 libcrypt-dev; do
+            path=$(awk -v p="$pkg" '$1=="Package:"&&$2==p{f=1} f&&$1=="Filename:"{print $2; exit}' "$TMP/Packages")
+            if [ -n "$path" ]; then
+              curl -sL "$APT_BASE/$path" -o "$TMP/pkg.deb"
+              sudo dpkg-deb -x "$TMP/pkg.deb" "$SYSROOT"
+            else
+              echo "WARNING: $pkg not found in focal Packages"
+            fi
+          done
+          # Absolute symlinks from the .debs point at host paths; rewrite
+          # them to stay inside the sysroot so -lpthread/-ldl resolve to
+          # target libs.
+          sudo find "$SYSROOT" -type l 2>/dev/null | while read -r l; do
+            t="$(readlink "$l")"
+            case "$t" in /*) sudo ln -sfn "$SYSROOT$t" "$l" ;; esac
+          done
+          # usrmerge fallback: libc.so linker script uses /lib/<triple>/ paths.
+          TRIPLE="x86_64-linux-gnu"
+          if ! [ -e "$SYSROOT/lib/$TRIPLE/libc.so.6" ]; then
+            sudo mkdir -p "$SYSROOT/lib"
+            sudo ln -sfn "../usr/lib/$TRIPLE" "$SYSROOT/lib/$TRIPLE"
+          fi
+          if ! [ -e "$SYSROOT/lib64" ]; then
+            sudo ln -sfn "usr/lib/$TRIPLE" "$SYSROOT/lib64"
+          fi
+          # 3. gcc-13 (libstdc++-13-dev, libgcc-13-dev) from the same mirrored
+          #    release the WebKit Dockerfile uses — aligns libstdc++ ABI with
+          #    the prebuilt WebKit.
+          curl -sL "https://github.com/oven-sh/WebKit/releases/download/gcc-13-focal-debs/gcc-13-focal-amd64.tar.gz" \
+            -o "$TMP/gcc13.tar.gz"
+          mkdir -p "$TMP/gcc13"
+          tar -xzf "$TMP/gcc13.tar.gz" -C "$TMP/gcc13"
+          for deb in "$TMP/gcc13"/*.deb; do
+            sudo dpkg-deb -x "$deb" "$SYSROOT"
+          done
+          sudo rm -rf "$TMP"
+          [ -d "$SYSROOT/usr/include/c++/13" ] || { echo "ERROR: $SYSROOT missing usr/include/c++/13"; exit 1; }
+          echo "=== sysroot installed ==="
+          ls "$SYSROOT/usr/include/c++/13" | head -5 || true
+          echo "=== libc.so.6 ==="
+          ls -la "$SYSROOT/lib/$TRIPLE/libc.so.6" "$SYSROOT/lib64" 2>&1 || true
+          echo "=== LINUX_GLIBC_SYSROOT=$SYSROOT ==="
+          echo "LINUX_GLIBC_SYSROOT=$SYSROOT" >> "$GITHUB_ENV"
+
+      # ── Configure + build ──────────────────────────────────────────────
+      # Explicit --os/--arch: host is always aarch64, target must NOT be
+      # inferred from host. --webkit=prebuilt is mandatory for windows cross
+      # (config.ts 1069 rejects --webkit=local) and for darwin cross (same
+      # block — --webkit=local would need a macOS native cmake). LTO: linux
+      # gnu cross and darwin cross both default ON (ltoDefault covers
+      # `linux || darwinCross`); windows stays default (off).
+      # --ci=true: for windows, config.ts 1052 only auto-resolves the winsysroot
+      # into cacheDir/winsysroot (so ensureWindowsSysroot() fetches xwin) when
+      # `ci || buildkite`. For linux it isn't needed for sysroot detection
+      # (detectLinuxGlibcSysroot has no ci gate) but keeps cacheDir per-build.
+      # For darwin, ensureMacosSdk() runs at configure time (called from
+      # configure()) and xmac-downloads MacOSX26.5.sdk into cacheDir when not
+      # already present — `--ci=true` keeps that cache per-build-dir.
+      # (build-x86.yml's native legs don't need this — host.os matches target.)
+      - name: Configure + build Bun
+        run: |
+          set -eo pipefail
+          echo "=== toolchain ==="
+          clang --version | head -1
+          echo "=== build:release (${{ matrix.label }} cross, webkit=prebuilt) ==="
+          bun scripts/build.ts \
+            --profile=release \
+            --ci=true \
+            --os=${{ matrix.os }} \
+            --arch=${{ matrix.arch }} \
+            ${{ matrix.abi && format('--abi={0}', matrix.abi) || '' }} \
+            --webkit=prebuilt \
+            --build-dir=${{ matrix.build-dir }} 2>&1 | tee build.log; rc=$?
+          if [ "$rc" -ne 0 ]; then
+            echo "=== build failed (rc=$rc) — first errors ==="
+            grep -inE "error\[|error:|fatal error|undefined reference|ld: error|lld-link:|ld64\.lld|collect2:|cannot find|FAILED:|panic|not found|missing|xwin|winsysroot|sysroot|xmac|macos-sdk|MacOSX|isysroot|mach-o|Mach-O" build.log | head -50 || true
+            echo "=== last 80 lines ==="
+            tail -80 build.log || true
+            exit 1
+          fi
+          echo "=== build OK ==="
+
+      # ── Verify binary ──────────────────────────────────────────────────
+      - name: Verify binary
+        run: |
+          set -e
+          OUT="${{ matrix.build-dir }}/${{ matrix.exe }}"
+          # Fallback: some profiles name the output bun-profile(.exe).
+          [ -f "$OUT" ] || OUT="${{ matrix.build-dir }}/bun-profile${{ matrix.os == 'windows' && '.exe' || '' }}"
+          [ -f "$OUT" ] || { echo "ERROR: binary not found at $OUT"; ls -la "${{ matrix.build-dir }}"; exit 1; }
+          echo "=== binary ==="
+          ls -lh "$OUT"
+          file "$OUT" || true
+          if [ "${{ matrix.os }}" = "linux" ]; then
+            # Expected ELF machine follows the leg's arch token — the shared
+            # verify step serves both linux legs (x64 and the native arm64).
+            case "${{ matrix.arch }}" in
+              x64)    elf_re="ELF.*x86-64" ;;
+              aarch64) elf_re="ELF.*(aarch64|ARM aarch64)" ;;
+              *)      elf_re="ELF" ;;
+            esac
+            file "$OUT" | grep -iqE "$elf_re" || { echo "ERROR: not the expected ELF ($elf_re)"; exit 1; }
+            echo "=== ELF header (readelf -h) ==="
+            readelf -h "$OUT" 2>/dev/null | head -20 || true
+            echo "=== Machine ==="
+            readelf -h "$OUT" 2>/dev/null | grep -i "Machine" || true
+            echo "=== dynamic deps (NEEDED) ==="
+            readelf -d "$OUT" 2>/dev/null | grep NEEDED || true
+            echo "=== version requirements (verneed) — must be <= 2.31 sysroot / 2.17 wrap floor ==="
+            readelf -V "$OUT" 2>/dev/null | grep -iE "GLIBC|Version" | head -30 || true
+          elif [ "${{ matrix.os }}" = "darwin" ]; then
+            file "$OUT" | grep -iqE "Mach-O.*arm64|Mach-O 64-bit.*arm64" || { echo "ERROR: not a Mach-O arm64"; exit 1; }
+            echo "=== Mach-O arch (llvm-objdump) ==="
+            llvm-objdump -f "$OUT" | grep -iE "architecture|file format" || true
+            echo "=== Mach-O headers (llvm-objdump -h) ==="
+            llvm-objdump -h "$OUT" 2>/dev/null | head -30 || true
+            echo "=== LC_BUILD_VERSION (deployment target) ==="
+            llvm-objdump --macho --private-headers "$OUT" 2>/dev/null | grep -iE "LC_BUILD_VERSION|minos|platform|sdk" || true
+          else
+            file "$OUT" | grep -iqE "PE32|MS-DOS|Windows" || { echo "ERROR: not a Windows PE"; exit 1; }
+            echo "=== PE arch (llvm-objdump) ==="
+            llvm-objdump -f "$OUT" | grep -iE "architecture|file format" || true
+          fi
+          echo "=== validation OK ==="
+
+      - name: Dump failure diagnostics
+        if: failure()
+        run: |
+          echo "=== build dir ==="; ls -la "${{ matrix.build-dir }}" 2>&1 | head -30 || true
+          echo "=== first 80 error lines from build.log ==="
+          grep -inE "error\[|error:|fatal error|undefined reference|ld: error|lld-link:|ld64\.lld|collect2:|cannot find|FAILED:|panic|not found|missing|xwin|winsysroot|sysroot|xmac|macos-sdk|MacOSX|isysroot|mach-o|Mach-O|c\+\+|GLIBC|libc|apple-macosx" build.log 2>/dev/null | head -80 || true
+          echo "=== last 150 lines of build.log ==="
+          tail -150 build.log 2>/dev/null || true
+
+      - name: Upload binary
+        if: success()
+        uses: actions/upload-artifact@v4
+        with:
+          name: bun-cross-${{ matrix.label }}
+          path: ${{ matrix.build-dir }}/${{ matrix.exe }}
+          if-no-files-found: warn
+          retention-days: 14
+
+      - name: Upload build log
+        if: failure()
+        uses: actions/upload-artifact@v4
+        with:
+          name: build-log-${{ matrix.label }}
+          path: build.log
+          if-no-files-found: ignore
+          retention-days: 7
diff --git a/.github/workflows/ohos-brew-deps-canary.yml b/.github/workflows/ohos-brew-deps-canary.yml
new file mode 100644
index 00000000000..dfadc00cb25
--- /dev/null
+++ b/.github/workflows/ohos-brew-deps-canary.yml
@@ -0,0 +1,160 @@
+# Daily drift sentinel for the OHOS container lane's brew dependency
+# contract.
+#
+# The build lane (ohos-build-github.yml) pins harmonybrew/core to
+# OHOS_CORE_PIN (2026-09-16: floating core switched llvm@21 to the
+# sysroot-less ohos-sdk-native and every PR went red in configure), so
+# tap-side restructures no longer reach PR gating. This canary therefore
+# floats ON PURPOSE: it consumes core at origin/main and runs the same
+# install + verification steps on a schedule, so a newer core tip gets a
+# daily validation decoupled from PR gating. Green on a newer tip = bump
+# OHOS_CORE_PIN; the Pour step prints the exact tip SHA for copy-paste.
+# It pours only (no source build): a full run costs a few minutes on a
+# warm runner.
+#
+# Formula names are resolved dynamically — the sdk from llvm@21's deps,
+# the verified set from bun.rb's current resolved tree — so a rename alone
+# should not turn this red. Red means the evaluation itself broke (a pour
+# failure — atomgit CDN 404s are retried once below — or a missing keg).
+# A sysroot-less floating tip is NOT red: that is the normal
+# "nothing to bump" steady state (the build lane stays pinned) and is
+# reported as a warning — steady-state red is alarm fatigue. Mirror fixes
+# into ohos-build-github.yml, whose install/verify steps must stay in
+# sync with this file.
+
+name: OHOS brew-deps canary (container)
+
+on:
+  schedule:
+    - cron: "23 2 * * *"
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: ohos-brew-deps-canary
+  cancel-in-progress: false
+
+env:
+  OHOS_CI_IMAGE: ${{ vars.OHOS_CI_IMAGE }}
+  OHOS_TAP: ${{ vars.OHOS_TAP }}
+  BREW_ENV: HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ANALYTICS=1 HOMEBREW_NO_ENV_HINTS=1
+
+jobs:
+  brew-deps:
+    name: brew deps canary (container)
+    runs-on: ubuntu-24.04-arm
+    timeout-minutes: 45
+    steps:
+      - name: Pull and start OHOS container
+        run: |
+          docker pull "$OHOS_CI_IMAGE"
+          docker run -d --name ohos-canary --init \
+            --security-opt seccomp=unconfined \
+            "$OHOS_CI_IMAGE" sleep infinity
+
+      # Same ordering as the build lane: safe.directory BEFORE brew trust,
+      # and trust BEFORE any install — without trust, TRANSITIVE tap deps
+      # (loaded via depends_on, not named on the command line) silently
+      # refuse to load and the pour installs nothing while exiting 0.
+      - name: Configure container (tap trust)
+        run: |
+          TAP_IN_CONTAINER="${{ vars.OHOS_TAP_IN_CONTAINER }}"
+          docker exec ohos-canary bash -lc \
+            "git config --global --add safe.directory $TAP_IN_CONTAINER || true"
+          docker exec ohos-canary bash -lc "$BREW_ENV brew tap $OHOS_TAP || true"
+          docker exec ohos-canary bash -lc "$BREW_ENV brew trust $OHOS_TAP"
+
+      - name: Pour deps (bun formula deps only)
+        run: |
+          set -e
+          set -o pipefail
+          docker exec ohos-canary bash -lc "$BREW_ENV brew update --quiet" \
+            || echo "::warning::brew update failed; continuing with baked index"
+          for i in 1 2; do
+            if docker exec ohos-canary bash -lc \
+              "$BREW_ENV brew install --only-dependencies --build-bottle $OHOS_TAP/bun" 2>&1 | tail -40; then
+              break
+            fi
+            [ "$i" = 2 ] && { echo "::error::brew install --only-dependencies failed after retry"; exit 1; }
+            echo "::warning::brew install attempt $i failed, retrying in 90s"
+            sleep 90
+          done
+          # The sdk left bun.rb's direct deps (2026-09-12) and now hangs off
+          # llvm@21's deps under an @version-suffixed name — the pour skips
+          # the baked llvm@21 without re-resolving, so resolve the name from
+          # llvm@21's current formula and pour it explicitly. bun-bootstrap
+          # left the direct deps too and remains the build driver's bun.
+          SDK_FORMULA=$(docker exec ohos-canary bash -lc "$BREW_ENV brew deps --include-build llvm@21 2>/dev/null | grep -E '^ohos-sdk' | head -1" || true)
+          SDK_FORMULA=${SDK_FORMULA:-ohos-sdk}
+          echo "sdk formula (from llvm@21 deps): $SDK_FORMULA"
+          echo "SDK_FORMULA=$SDK_FORMULA" >> "$GITHUB_ENV"
+          docker exec ohos-canary bash -lc "$BREW_ENV brew install $SDK_FORMULA" 2>&1 | tail -3 \
+            || echo "::warning::$SDK_FORMULA install failed"
+          # bun-bootstrap vanished from the floating tap and its bottle was
+          # pruned from the harmonybrew CDN (2026-09-22+ tap restructure; the
+          # build lane falls back the same way). The tap's own bun.rb /
+          # bun@1.4.rb bottles are prebuilt OHOS bun in the same driver role.
+          # The auto-sign pass corrupts bun ELFs on a re-sign (upstream
+          # build.sh) — unset the baked sign env for these pours.
+          docker exec ohos-canary bash -lc '
+            unset HOMEBREW_OHOS_BOTTLE_BINARY_SIGN
+            for k in bun-bootstrap bun bun@1.4; do
+              p="$(brew --prefix "$k" 2>/dev/null)/bin/bun"
+              if [ ! -x "$p" ] || ! "$p" --version >/dev/null 2>&1; then
+                brew install --force "$k" >/dev/null 2>&1 \
+                  || brew install --force "social4hyq/core/$k" >/dev/null 2>&1 || true
+                p="$(brew --prefix "$k" 2>/dev/null)/bin/bun"
+              fi
+              [ -x "$p" ] && "$p" --version >/dev/null 2>&1 \
+                && { echo "driver bun keg: $k"; break; }
+            done
+          ' || echo "::warning::no build driver bun from tap (bun-bootstrap, bun, bun@1.4 all failed)"
+          docker exec ohos-canary bash -lc "$BREW_ENV brew install zlib" 2>&1 | tail -3 \
+            || echo "::warning::zlib install failed (cargo links it)"
+          # The build lane pins this tap (OHOS_CORE_PIN in
+          # ohos-build-github.yml); a green canary on a newer tip is the
+          # signal to bump it — print the exact SHA so the bump is one paste.
+          CORE_SHA=$(docker exec ohos-canary bash -lc \
+            'git -C "$(brew --repo harmonybrew/core)" rev-parse HEAD' || true)
+          echo "harmonybrew/core tip validated: ${CORE_SHA:-<unavailable>}"
+          echo "CORE_SHA=$CORE_SHA" >> "$GITHUB_ENV"
+
+      - name: Verify kegs (representative set + dynamic sdk)
+        run: |
+          set -e
+          set -o pipefail
+          docker exec -e SDK_FORMULA="$SDK_FORMULA" -e CORE_SHA="${CORE_SHA:-}" ohos-canary bash -lc '
+            for f in llvm@21 "${SDK_FORMULA:-ohos-sdk}" icu4c@78 openssl@3 cmake ninja zlib; do
+              p=$(brew --prefix "$f" 2>/dev/null) && [ -d "$p" ] \
+                && echo "OK  $f -> $p" \
+                || { echo "::error::$f NOT installed (formula missing/renamed in the floating tap, or silent trust rejection)"; exit 1; }
+            done
+            # Build driver: bun-bootstrap while the tap still carries it, else
+            # the bun / bun@1.4 bottle fallback (2026-09-26 — mirrored from the
+            # build lane). A candidate only counts once its binary runs; a tip
+            # where no driver keg pours is a broken tip.
+            driver=""
+            for k in bun-bootstrap bun bun@1.4; do
+              p="$(brew --prefix "$k" 2>/dev/null)/bin/bun"
+              [ -x "$p" ] && "$p" --version >/dev/null 2>&1 && { driver="$p"; break; }
+            done
+            [ -n "$driver" ] \
+              || { echo "::error::no runnable build driver bun (kegs all unusable)"; exit 1; }
+            echo "OK  driver bun -> $driver ($("$driver" --version 2>/dev/null | head -1))"
+            # Same sysroot contract as the build lane verify step: a renamed
+            # sdk keg without native/sysroot pours fine and kills configure.
+            # Absent sysroot = tip not consumable: warn and pass (keep the
+            # pin); red stays reserved for a broken evaluation.
+            sysroot=""
+            for d in "$(brew --prefix)"/opt/ohos-sdk*/; do
+              [ -d "${d}native/sysroot" ] && { sysroot="${d}native/sysroot"; break; }
+            done
+            if [ -n "$sysroot" ]; then
+              echo "OK  sysroot -> $sysroot (tip consumable — bump OHOS_CORE_PIN to ${CORE_SHA:-<unavailable>})"
+            else
+              echo "::warning::no ohos-sdk* keg carries native/sysroot — tip NOT consumable, keep OHOS_CORE_PIN"
+            fi
+            echo "=== clang ==="; $(brew --prefix llvm@21)/bin/clang --version | head -1
+          '
