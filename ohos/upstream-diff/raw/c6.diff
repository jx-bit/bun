index 00000000000..0246e734e53
--- /dev/null
+++ b/.github/workflows/ohos-container-test.yml
@@ -0,0 +1,325 @@
+# ──────────────────────────────────────────────────────────────────────
+# OHOS container test lane
+#
+# Runs the JS test suite against the freshly built OHOS aarch64 binary
+# INSIDE the ci-runner image (the same OHOS userland the build links
+# against). No self-hosted runner, no device — fully GitHub-hosted.
+#
+#   resolve-binary: download the binary from ohos-build-github.yml's
+#     artifact (same commit when available, latest successful fallback)
+#   test: brew runtime deps pour node (harness runner); bun install
+#     (root + test/) with the tested binary; runner.node.mjs with
+#     --exec-path=<tested binary>
+#
+# The device/self-hosted lane remains in ohos-full-test.yml (unchanged).
+# Triggers: push paths / dispatch. No schedule: the full suite minus five
+# exclusions is structurally red on the port's known-failure baseline —
+# run on demand, optionally with --test-filter for a partial pass.
+# ──────────────────────────────────────────────────────────────────────
+
+name: ohos-container-test
+
+run-name: "ohos-container-test (filter=${{ inputs.test-filter || 'none' }})"
+
+on:
+  push:
+    branches:
+      - ohos-aarch64
+    paths:
+      - '.github/workflows/ohos-container-test.yml'
+  pull_request:
+    branches:
+      - ohos-aarch64
+    paths:
+      - '.github/workflows/ohos-container-test.yml'
+  workflow_dispatch:
+    inputs:
+      test-filter:
+        description: 'Optional --include substring filter (e.g. "js/node/test/parallel"), for a quick partial run instead of the full suite'
+        required: false
+        type: string
+        default: ''
+
+permissions:
+  contents: read
+  actions: read
+
+concurrency:
+  group: ohos-container-test-${{ github.event_name }}-${{ github.event.number || github.ref }}
+  cancel-in-progress: false
+
+env:
+  # Build job env (self-hosted runner)
+  OHOS_SDK_ROOT: /home/user/setup-ohos-sdk
+  OHOS_SYSROOT: /home/user/setup-ohos-sdk/ohos/native/sysroot
+  OHOS_CROSS_LIBS: /home/user/sources/bun/build/ohos-cross-libs
+  OHOS_ICU_DIR: /home/user/sources/bun/build/ohos-icu/target
+  CARGO_INCREMENTAL: 1
+  CARGO_TARGET_DIR: /home/user/sources/bun/build/release-ohos/rust-target
+  RUSTC_WRAPPER: ""
+  NINJA_JOBS: 2
+  WEBKIT_FORK: oven-sh/WebKit
+  WEBKIT_REF: caad865eb1a6e5ca4427f5ea1f066140b11953e7
+
+defaults:
+  run:
+    shell: bash -euo pipefail {0}
+
+jobs:
+  # ──────────────────────────────────────────────────────────────────────
+  # Resolve binary: fetch the OHOS aarch64 binary built by the github-
+  # hosted lane (ohos-build-github.yml, artifact bun-ohos-aarch64-github,
+  # ubuntu-24.04-arm) instead of building on the self-hosted runner.
+  # Prefers a run for the exact commit under test; falls back to the
+  # latest successful run. Re-uploads as bun-ohos-binary so the test
+  # job's download step stays unchanged.
+  # ──────────────────────────────────────────────────────────────────────
+  resolve-binary:
+    name: Resolve OHOS binary
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    env:
+      GH_TOKEN: ${{ github.token }}
+    steps:
+      - name: Locate the latest successful ohos-build-github run
+        id: locate
+        run: |
+          SHA="${{ github.sha }}"
+          RUN_ID=$(gh api "repos/${GITHUB_REPOSITORY}/actions/workflows/ohos-build-github.yml/runs?status=success&per_page=30" \
+            --jq ".workflow_runs[] | select(.head_sha == \"$SHA\") | .id" | head -1)
+          if [ -z "$RUN_ID" ]; then
+            echo "No build for $SHA — falling back to latest successful run"
+            RUN_ID=$(gh api "repos/${GITHUB_REPOSITORY}/actions/workflows/ohos-build-github.yml/runs?status=success&per_page=1" --jq '.workflow_runs[0].id')
+            gh api "repos/${GITHUB_REPOSITORY}/actions/runs/$RUN_ID" --jq '"from sha " + .head_sha[:12] + " (" + .head_branch + ")"'
+          fi
+          echo "run_id=$RUN_ID" >> "$GITHUB_OUTPUT"
+          echo "Using ohos-build-github run $RUN_ID"
+
+      - name: Download binary artifact
+        uses: actions/download-artifact@v4
+        with:
+          name: bun-ohos-aarch64-github
+          path: bin
+          run-id: ${{ steps.locate.outputs.run_id }}
+          github-token: ${{ github.token }}
+
+      - name: Verify binary
+        run: |
+          file bin/bun
+          file bin/bun | grep -q "ELF.*ARM aarch64" || {
+            echo "ERROR: Downloaded binary is not an ARM64 ELF"
+            exit 1
+          }
+          echo "✅ Binary resolved from ohos-build-github run ${{ steps.locate.outputs.run_id }}"
+
+      - name: Upload as bun-ohos-binary
+        uses: actions/upload-artifact@v4
+        with:
+          name: container-test-binary
+          path: bin/bun
+          retention-days: 7
+          if-no-files-found: error
+
+
+
+  # ──────────────────────────────────────────────────────────────────────
+  # Test job: run the suite inside the ci-runner image — the SAME OHOS
+  # userland ohos-build-github.yml builds in. The image's own /lib loader
+  # is the OHOS musl fork the binary links against, so no runtime-lib
+  # injection is needed (the vanilla-ubuntu + musl-tools + loader-symlink
+  # approach failed: the binary also links OHOS-specific symbols the
+  # generic musl lacks). brew's runtime deps provide node (the harness
+  # runner); the binary under test is the exec-path.
+  # ──────────────────────────────────────────────────────────────────────
+  test:
+    name: Test OHOS binary (ci-runner)
+    needs: resolve-binary
+    runs-on: ubuntu-24.04-arm
+    timeout-minutes: 240
+    env:
+      CONTAINER_IMAGE: ${{ vars.OHOS_CI_IMAGE }}
+      CONTAINER: ohos-container-test
+      TAP: ${{ vars.OHOS_TAP }}
+      BREW_ENV: HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ANALYTICS=1 HOMEBREW_NO_ENV_HINTS=1
+    steps:
+      - name: Checkout Bun source
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 1
+
+      - name: Download OHOS binary
+        uses: actions/download-artifact@v4
+        with:
+          name: container-test-binary
+          path: .bin-ohos
+
+      # Free disk space on the github-hosted runner. The source tree +
+      # node_modules + the container's writable layer (every test's /tmp
+      # writes land in docker storage) together can exceed the runner's
+      # available space — run 34183365924 died with ENOSPC at ~2300/5969
+      # files. The reference OHOS CI workflow does the same cleanup.
+      - name: Free disk space
+        run: |
+          echo "Before cleanup:"
+          df -h / | tail -1
+          sudo rm -rf /usr/share/dotnet \
+                      /usr/local/lib/android \
+                      /opt/ghc \
+                      /opt/powershell \
+                      /usr/local/.ghcup \
+                      /opt/swift \
+                      /usr/local/swift 2>/dev/null || true
+          echo "After cleanup:"
+          df -h / | tail -1
+
+      - name: Pull and start ci-runner container
+        run: |
+          docker pull "$CONTAINER_IMAGE"
+          docker run -d --name "$CONTAINER" --init \
+            --security-opt seccomp=unconfined \
+            -v "$GITHUB_WORKSPACE:/workspace/bun" \
+            "$CONTAINER_IMAGE" sleep infinity
+
+      - name: Configure container (device path fixup)
+        run: |
+          # PT_INTERP targets real-device paths (/system/bin/sh,
+          # /system/lib/ld-musl-aarch64.so.1); musl tmpfile() hardcodes
+          # /data/local/tmp. The image's own /lib loader IS the OHOS libc.
+          docker exec "$CONTAINER" bash -lc \
+            'mkdir -p /data/local/tmp /system/bin /system/lib && \
+             ln -sf /bin/sh /system/bin/sh && \
+             ln -sf /lib/ld-musl-aarch64.so.1 /system/lib/ld-musl-aarch64.so.1'
+          # the checkout is runner-owned; container git (rev-parse for the
+          # failure annotations) would die on dubious ownership otherwise
+          docker exec "$CONTAINER" bash -lc \
+            'git config --global --add safe.directory /workspace/bun || true'
+
+      - name: Stage binary and verify
+        run: |
+          docker cp .bin-ohos/bun "$CONTAINER:/workspace/bun/bun-ohos"
+          docker exec "$CONTAINER" bash -lc 'chmod 755 /workspace/bun/bun-ohos'
+          docker exec "$CONTAINER" bash -lc '/workspace/bun/bun-ohos --version' \
+            || { echo "ERROR: OHOS binary failed to execute in ci-runner"; exit 1; }
+          echo "OK: OHOS binary runs in ci-runner container"
+
+      - name: Install brew runtime deps + resolve runner interpreter
+        run: |
+          docker exec "$CONTAINER" bash -lc \
+            "git config --global --add safe.directory /storage/Users/currentUser/.harmonybrew/Library/Taps/$TAP 2>/dev/null || true"
+          docker exec "$CONTAINER" bash -lc "$BREW_ENV brew tap $TAP || true"
+          docker exec "$CONTAINER" bash -lc "$BREW_ENV brew trust $TAP"
+          # Surgical brew update: the image's baked default-tap index can
+          # reference node bottles the CDN has pruned (baked 26.4.0 vs live
+          # 26.5.0 → 404 → the runner falls back to the tested binary). A
+          # plain `brew update` refreshes the default tap's index before the
+          # node install — the reference OHOS CI lane does exactly this.
+          docker exec "$CONTAINER" bash -lc "brew update" 2>&1 | tail -2 || true
+          # llvm@21 bottle: the node-gyp tests (test/napi/*) need a C++
+          # toolchain whose libc++ has C++20 headers (node-26 headers include
+          # <source_location>) — without it the addon build dies and the napi
+          # family fails (31 files in run 34079587941). The keg ships the
+          # header and the arm64_ohos bottle pours in seconds.
+          docker exec "$CONTAINER" bash -lc "$BREW_ENV brew install llvm@21" 2>&1 | tail -3 \
+            || echo "::warning::llvm@21 install failed — napi node-gyp tests will fail"
+          # best-effort: the node bottle has 404'd on the CDN before; the
+          # runner has a three-level fallback below
+          # node comes from the DEFAULT core tap (its arm64_ohos bottle
+          # exists and runner.node.mjs activates under it — confirmed by
+          # the upstream fulltest design). The social4hyq/core tap's node
+          # bottle 404s on the CDN.
+          # best-effort: the arm64_ohos node bottle has been pruned from
+          # the CDN (404) — the runner falls back to the tested binary
+          # (proven in R12: 172 files, 99.36% with the self-runner)
+          docker exec "$CONTAINER" bash -lc \
+            "$BREW_ENV brew install node 2>&1 | tail -10 || echo '::warning::node bottle unavailable - runner falls back to the tested binary'"
+          # runner interpreter: brew node -> brew bun -> the tested binary
+          RUNNER=$(docker exec "$CONTAINER" bash -lc \
+            'if command -v node >/dev/null 2>&1; then echo node; \
+             elif [ -x "$(brew --prefix bun-bootstrap 2>/dev/null)/bin/bun" ]; then \
+               echo "$(brew --prefix bun-bootstrap)/bin/bun"; \
+             else echo SELF; fi' | tr -d '\r')
+          if [ "$RUNNER" = "SELF" ]; then
+            echo "::warning::no node/bun in ci-runner — runner falls back to the tested binary itself"
+            RUNNER="/workspace/bun/bun-ohos"
+          fi
+          docker exec "$CONTAINER" bash -lc "'$RUNNER' --version" || { echo "ERROR: runner interpreter broken"; exit 1; }
+          echo "RUNNER=$RUNNER" >> "$GITHUB_ENV"
+
+      - name: Install test dependencies
+        run: |
+          # with the tested binary itself — exercises the OHOS package
+          # manager; --ignore-scripts skips esbuild's platform-detection
+          # postinstall (OHOS node reports openharmony)
+          docker exec -e BUN_INSTALL_IGNORE_SCRIPTS=1 "$CONTAINER" bash -lc \
+            'cd /workspace/bun && ./bun-ohos install --ignore-scripts' 2>&1 | tail -10
+          docker exec -e BUN_INSTALL_IGNORE_SCRIPTS=1 "$CONTAINER" bash -lc \
+            'cd /workspace/bun/test && ../bun-ohos install --ignore-scripts' 2>&1 | tail -10
+          docker exec "$CONTAINER" bash -lc \
+            '[ -d /workspace/bun/test/node_modules ] && echo "node_modules OK" || { echo "ERROR: test/node_modules missing"; exit 1; }'
+
+      # Run the test suite. The image's node (poured via brew, reports
+      # openharmony) runs runner.node.mjs; the tested binary is --exec-path.
+      # GITHUB_ACTIONS is NOT passed into the container (runner.node.mjs has
+      # GITHUB_REPOSITORY-dependent code paths); CI=true only.
+      - name: Run test suite
+        env:
+          TEST_FILTER: ${{ inputs.test-filter }}
+        run: |
+          INCLUDE_ARGS=()
+          if [ -n "$TEST_FILTER" ]; then
+            INCLUDE_ARGS=(--include="$TEST_FILTER")
+          fi
+
+          set +e
+          docker exec \
+            -e CI=true \
+            -e BUN_TEST_NO_SECRETS=1 \
+            "$CONTAINER" bash -lc '
+              cd /workspace/bun
+              '"$RUNNER"' scripts/runner.node.mjs \
+                --exec-path=/workspace/bun/bun-ohos \
+                --quiet \
+                --parallel \
+                --retries=1 \
+                --results-json=results.json \
+                --exclude=integration/bun-types \
+                --exclude=internal/source-lints \
+                --exclude=bake/dev \
+                --exclude=js/bun/ffi/cc.test.ts \
+                --exclude=regression/issue/20144 \
+                --exclude=regression/issue/26249 \
+                "$@"
+            ' _ "${INCLUDE_ARGS[@]}"
+          RUNNER_EXIT=$?
+          set -e
+
+          echo "runner exit code: $RUNNER_EXIT"
+          docker cp "$CONTAINER":/workspace/bun/results.json results.json 2>/dev/null || true
+          exit $RUNNER_EXIT
+
+
+      - name: Upload results
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: ohos-container-test-results-${{ github.run_number }}
+          path: results.json
+          retention-days: 30
+          if-no-files-found: ignore
+
+      - name: Dump container diagnostics on failure
+        if: failure()
+        run: |
+          echo "=== container status ==="
+          docker ps -a --filter "name=$CONTAINER" || true
+          echo "=== container logs (last 80 lines) ==="
+          docker logs --tail 80 "$CONTAINER" 2>&1 || true
+          echo "=== binary info ==="
+          docker exec "$CONTAINER" bash -lc 'file /workspace/bun/bun-ohos; ls -lh /workspace/bun/bun-ohos' 2>/dev/null || true
+          echo "=== node_modules check ==="
+          docker exec "$CONTAINER" bash -lc 'ls /workspace/bun/node_modules/ 2>/dev/null | head -20 || echo "no node_modules"' 2>/dev/null || true
+
+      - name: Cleanup container
+        if: always()
+        run: |
+          docker rm -f "$CONTAINER" 2>/dev/null || true
diff --git a/.github/workflows/ohos-full-test.yml b/.github/workflows/ohos-full-test.yml
new file mode 100644
index 00000000000..58034157c08
--- /dev/null
+++ b/.github/workflows/ohos-full-test.yml
@@ -0,0 +1,595 @@
+# OHOS Full Test Suite — two-stage build + container test
+#
+# Manual / on-change only (no schedule): the weekly cron's self-hosted
+# build job once sat 24h awaiting a runner — run via dispatch instead.
+#
+# DESIGN DECISIONS:
+#
+# 1. Two jobs: build (self-hosted) -> test (github-hosted + Docker)
+#    - Build job reuses ohos-build-rust.yml's proven incremental build on
+#      the self-hosted runner (OHOS SDK, LLVM 22, cross-libs, ICU all present).
+#      The binary is uploaded as a GitHub Actions artifact.
+#    - Test job runs on github-hosted ubuntu-24.04-arm, starts an ubuntu:24.04
+#      container with musl-tools installed, downloads the binary artifact,
+#      and runs the test suite with the freshly built OHOS binary as
+#      --exec-path.
+#
+# 2. Why not build on github-hosted? The build needs OHOS SDK + LLVM 22 +
+#    cross-libs + ICU -- all present on the self-hosted runner. Reproducing
+#    that on github-hosted requires the full container build pipeline
+#    (ohos-build-github.yml, ~20 min of brew deps). This workflow focuses
+#    on TESTING: build on the fast self-hosted runner, test on the
+#    reproducible github-hosted container.
+#
+# 3. Container approach (ubuntu:24.04 + musl-tools):
+#    - ubuntu:24.04 base image (no external registry auth needed).
+#    - musl-tools provides /lib/ld-musl-aarch64.so.1 (the OHOS binary's
+#      PT_INTERP dynamic linker).
+#    - symlink fixup: /system/bin/sh, /system/lib/ld-musl-aarch64.so.1
+#      (bun's PT_INTERP targets real-device paths).
+#    - node from NodeSource runs runner.node.mjs (the test harness).
+#    - --exec-path points to the freshly built OHOS binary (the code under
+#      test). The binary executes inside the container because the musl
+#      dynamic linker is available at the expected path after fixup.
+#
+# 4. The OHOS binary IS the test subject. The previous workflow used system
+#    bun as --exec-path (stable, pointless -- it tested the wrong binary).
+#    Now the freshly cross-compiled binary from this branch is tested directly.
+#
+# 5. bun install uses the OHOS binary itself (not system bun or npm). This
+#    exercises OHOS-specific code paths in the package manager. @esbuild/
+#    linux-arm64 is force-installed if missing (OHOS bun reports
+#    process.platform="openharmony" which filters {os:linux} optional deps).
+#
+# 6. No GITHUB_ACTIONS in the container: runner.node.mjs has code paths that
+#    depend on GITHUB_REPOSITORY etc. when GITHUB_ACTIONS is set. We only
+#    pass CI=true and BUN_TEST_NO_SECRETS=1 to the test exec.
+#
+# 7. No sharding (single serial job). --retries=1 (not 3) to save wall clock
+#    on slow failures. Same excludes as before (container segfaults on
+#    cc.test.ts + regression issues; bake/dev compiled off in release).
+#
+# Required runner environment (build job, same as ohos-build-rust.yml):
+#   - OHOS SDK at /home/user/setup-ohos-sdk/
+#   - LLVM 22 toolchain (musl-compatible)
+#   - Cross-compiled ICU at bun/build/ohos-icu/
+#   - Cross-compiled libc++ at bun/build/ohos-cross-libs/
+#   - System node (for running scripts/runner.node.mjs -- not needed here,
+#     node comes from the container in the test job)
+
+name: ohos-full-test
+
+run-name: "ohos-full-test (filter=${{ inputs.test-filter || 'none' }})"
+
+on:
+  push:
+    branches:
+      - ohos-aarch64
+    paths:
+      - '.github/workflows/ohos-full-test.yml'
+  workflow_dispatch:
+    inputs:
+      test-filter:
+        description: 'Optional --include substring filter (e.g. "js/node/test/parallel"), for a quick partial run instead of the full suite'
+        required: false
+        type: string
+        default: ''
+
+permissions:
+  contents: read
+
+concurrency:
+  group: ohos-full-test-${{ github.event_name }}
+  cancel-in-progress: false
+
+env:
+  # Build job env (self-hosted runner)
+  OHOS_SDK_ROOT: /home/user/setup-ohos-sdk
+  OHOS_SYSROOT: /home/user/setup-ohos-sdk/ohos/native/sysroot
+  OHOS_CROSS_LIBS: /home/user/sources/bun/build/ohos-cross-libs
+  OHOS_ICU_DIR: /home/user/sources/bun/build/ohos-icu/target
+  CARGO_INCREMENTAL: 1
+  CARGO_TARGET_DIR: /home/user/sources/bun/build/release-ohos/rust-target
+  RUSTC_WRAPPER: ""
+  NINJA_JOBS: 2
+  WEBKIT_FORK: oven-sh/WebKit
+  WEBKIT_REF: caad865eb1a6e5ca4427f5ea1f066140b11953e7
+
+defaults:
+  run:
+    shell: bash -euo pipefail {0}
+
+jobs:
+  # ──────────────────────────────────────────────────────────────────────
+  # Build job: compile the OHOS aarch64 binary on the self-hosted runner.
+  # Reuses ohos-build-rust.yml's incremental build logic (local reference
+  # clone, cargo cache, WebKit cache, ninja). Uploads the bare binary as
+  # an artifact for the test job.
+  # ──────────────────────────────────────────────────────────────────────
+  build:
+    name: Build OHOS binary
+    runs-on: [self-hosted, Linux, ARM64]
+    timeout-minutes: 300
+
+    steps:
+      - name: Checkout Bun source (incremental)
+        run: |
+          LOCAL=/home/user/sources/bun
+          rm -rf bun
+          if [ -d "$LOCAL/.git" ]; then
+            git clone --reference "$LOCAL/.git" \
+              https://ghfast.top/${{ github.server_url }}/${{ github.repository }}.git bun 2>/dev/null || \
+              git clone --depth 1 --branch "${{ github.ref_name }}" \
+                https://ghfast.top/${{ github.server_url }}/${{ github.repository }}.git bun
+            cd bun
+            git fetch origin "${{ github.ref }}" --depth=1
+            git checkout -f FETCH_HEAD
+            echo "Cloned from local reference @ ${{ github.sha }}"
+          else
+            git clone --depth 1 --branch "${{ github.ref_name }}" \
+              https://ghfast.top/${{ github.server_url }}/${{ github.repository }}.git bun
+            echo "Full clone (no local reference) @ ${{ github.sha }}"
+          fi
+
+      - name: Restore Rust cargo cache
+        run: |
+          mkdir -p bun/.cargo
+          SRC_CACHE=/home/user/sources/bun/.cargo
+          if [ -d "$SRC_CACHE/registry" ]; then
+            cp -a "$SRC_CACHE/registry" bun/.cargo/registry 2>/dev/null || true
+            echo "Copied cargo registry cache"
+          else
+            echo "No cargo registry cache found"
+          fi
+
+      - name: Restore Rust incremental build artifacts
+        run: |
+          SRC_TARGET=/home/user/sources/bun/build/release-ohos/rust-target
+          if [ -d "$SRC_TARGET" ]; then
+            mkdir -p bun/build/release-ohos
+            cp -a --link "$SRC_TARGET" bun/build/release-ohos/rust-target 2>/dev/null || \
+              cp -a "$SRC_TARGET" bun/build/release-ohos/rust-target 2>/dev/null || true
+            echo "Copied Rust incremental artifacts"
+          else
+            echo "No previous Rust artifacts (full rebuild)"
+          fi
+
+      - name: Checkout WebKit fork (incremental)
+        run: |
+          LOCAL_WK=/home/user/sources/bun/vendor/WebKit
+          WK_REPO=${{ env.WEBKIT_FORK }}
+          WK_REF=${{ env.WEBKIT_REF }}
+          rm -rf bun/vendor/WebKit
+          if [ -d "$LOCAL_WK/.git" ]; then
+            git clone --reference "$LOCAL_WK/.git" --dissociate \
+              --depth 1 --branch "$WK_REF" \
+              "https://ghfast.top/https://github.com/$WK_REPO.git" bun/vendor/WebKit 2>/dev/null || \
+            cp -a --link "$LOCAL_WK" bun/vendor/WebKit
+            cd bun/vendor/WebKit
+            git remote set-url origin "https://ghfast.top/https://github.com/$WK_REPO.git"
+            git fetch origin "$WK_REF" --depth=1 2>/dev/null || true
+            git checkout -f FETCH_HEAD 2>/dev/null || git checkout -f "$WK_REF"
+            echo "WebKit cloned from local reference"
+          else
+            git clone --depth 1 --branch "$WK_REF" \
+              "https://ghfast.top/https://github.com/$WK_REPO.git" bun/vendor/WebKit
+            echo "Full WebKit clone (no local reference)"
+          fi
+
+      - name: Install system dependencies
+        run: |
+          if ! rpm -q libatomic &>/dev/null; then
+            echo "libatomic not found — installing..."
+            dnf install -y libatomic 2>&1 | tail -3
+            echo "libatomic installed"
+          else
+            echo "libatomic already installed"
+          fi
+
+      - name: Setup environment
+        run: |
+          echo "OHOS_SDK_ROOT=${{ env.OHOS_SDK_ROOT }}" >> $GITHUB_ENV
+          echo "OHOS_SYSROOT=${{ env.OHOS_SYSROOT }}" >> $GITHUB_ENV
+          echo "OHOS_CROSS_LIBS=${{ env.OHOS_CROSS_LIBS }}" >> $GITHUB_ENV
+          echo "OHOS_ICU_DIR=${{ env.OHOS_ICU_DIR }}" >> $GITHUB_ENV
+          test -d "$OHOS_SDK_ROOT" || { echo "OHOS SDK not found"; exit 1; }
+          mkdir -p bun/build
+          [ -L bun/build/ohos-cross-libs ] && [ "$(readlink bun/build/ohos-cross-libs)" = "$OHOS_CROSS_LIBS" ] || ln -sfn "$OHOS_CROSS_LIBS" bun/build/ohos-cross-libs
+          [ -L bun/build/ohos-icu ] && [ "$(readlink bun/build/ohos-icu)" = "$(dirname $OHOS_ICU_DIR)" ] || ln -sfn "$(dirname $OHOS_ICU_DIR)" bun/build/ohos-icu
+          test -d bun/build/ohos-cross-libs/libcxx/lib || { echo "Cross libs not found"; exit 1; }
+          test -d bun/build/ohos-icu/target/lib || { echo "ICU not found"; exit 1; }
+          echo "PATH=$OHOS_SDK_ROOT/llvm-22/bin:$PATH" >> $GITHUB_ENV
+          echo "CC=$OHOS_SDK_ROOT/llvm-22/bin/clang" >> $GITHUB_ENV
+          echo "CXX=$OHOS_SDK_ROOT/llvm-22/bin/clang++" >> $GITHUB_ENV
+          echo "Environment ready (clang: $($OHOS_SDK_ROOT/llvm-22/bin/clang --version | head -1))"
+
+      - name: Restore incremental build artifacts
+        run: |
+          CACHE_DIR=/home/user/actions-runner/_work/_cache/ohos-build
+          if [ -d "$CACHE_DIR" ]; then
+            mkdir -p bun/build/release-ohos/deps
+            for dep_dir in deps/WebKit obj vendor; do
+              src="$CACHE_DIR/$dep_dir"
+              dst="bun/build/release-ohos/$dep_dir"
+              [ -d "$src" ] && cp -a --link "$src" "$dst" 2>/dev/null || true
+            done
+            echo "Restored cached build artifacts"
+          else
+            echo "No cached build artifacts (full build)"
+          fi
+
+      - name: Extract WebKit version for cache key
+        id: webkit-version
+        run: |
+          WK_VER=$(grep "^export const WEBKIT_VERSION" bun/scripts/build/deps/webkit.ts | grep -oE '[a-f0-9]{40}')
+          echo "version=${WK_VER}" >> $GITHUB_OUTPUT
+          echo "Cache key: webkit-ohos-test-${{ env.WEBKIT_REF }}-${WK_VER}"
+
+      - name: Cache WebKit build
+        uses: actions/cache@v4
+        id: webkit-cache
+        with:
+          path: bun/build/release-ohos/deps/WebKit
+          key: webkit-ohos-test-${{ env.WEBKIT_REF }}-${{ steps.webkit-version.outputs.version }}
+
+      - name: Configure Bun build
+        working-directory: bun
+        run: |
+          bun run build:release \
+            --os=ohos \
+            --arch=aarch64 \
+            --webkit=local \
+            --build-dir=build/release-ohos \
+            --ohos-sysroot=$OHOS_SYSROOT \
+            --configure-only
+        env:
+          CI: true
+
+      - name: Patch build.ninja for OHOS host compilation
+        working-directory: bun
+        run: |
+          if grep -q "llvm-22/bin/clang \$flags -o \$out \$in" build/release-ohos/build.ninja 2>/dev/null; then
+            sed -i 's|command = .*/llvm-22/bin/clang $flags -o $out $in|command = /usr/bin/clang $flags -o $out $in|' \
+              build/release-ohos/build.ninja
+            echo "Patched dep_host_cc to use system clang"
+          else
+            echo "dep_host_cc rule not found or already patched"
+          fi
+          if [ -f build/release-ohos/deps/WebKit/build.ninja ]; then
+            sed -i 's/-lpthreads/-lpthread/g' build/release-ohos/deps/WebKit/build.ninja
+            echo "Patched -lpthreads -> -lpthread"
+          fi
+          if [ -f .cargo/config.toml ] && grep -q 'aarch64-unknown-linux-gnu' .cargo/config.toml; then
+            python3 -c "
+          import re
+          with open('.cargo/config.toml', 'r') as f:
+              content = f.read()
+          content = re.sub(
+              r'\[target\.aarch64-unknown-linux-gnu\]\nlinker = \"[^\"]*\"',
+              '[target.aarch64-unknown-linux-gnu]\nlinker = \"/usr/bin/clang++\"',
+              content
+          )
+          with open('.cargo/config.toml', 'w') as f:
+              f.write(content)
+          print('Patched Rust host linker to system clang++')
+          " || echo "Could not patch .cargo/config.toml"
+          fi
+          if ! grep -q "RUSTUP_DIST_SERVER" build/release-ohos/build.ninja 2>/dev/null; then
+            RUST_DATE=$(grep -oE 'nightly-[0-9]{4}-[0-9]{2}-[0-9]{2}' rust-toolchain.toml | head -1 | cut -d- -f2-)
+            RUSTUP_DIST_SERVER=""
+            RUSTUP_UPDATE_ROOT=""
+            for mirror in \
+              "https://rsproxy.cn|https://rsproxy.cn/rustup" \
+              "https://mirrors.tuna.tsinghua.edu.cn/rustup|https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup" \
+              "https://static.rust-lang.org|https://static.rust-lang.org/rustup"; do
+              dist_server=$(echo "$mirror" | cut -d'|' -f1)
+              if curl -sfI --max-time 6 "$dist_server/dist/$RUST_DATE/channel-rust-nightly.toml.sha256" -o /dev/null 2>&1; then
+                RUSTUP_DIST_SERVER="$dist_server"
+                RUSTUP_UPDATE_ROOT=$(echo "$mirror" | cut -d'|' -f2)
+                break
+              fi
+            done
+            if [ -z "$RUSTUP_DIST_SERVER" ]; then
+              echo "No rustup mirror reachable, defaulting to rsproxy.cn"
+              RUSTUP_DIST_SERVER="https://rsproxy.cn"
+              RUSTUP_UPDATE_ROOT="https://rsproxy.cn/rustup"
+            fi
+            echo "Selected RUSTUP mirror: $RUSTUP_DIST_SERVER"
+            sed -i "s|--env=CARGO_HOME=/home/user/.cargo|--env=CARGO_HOME=/home/user/.cargo --env=RUSTUP_DIST_SERVER=$RUSTUP_DIST_SERVER --env=RUSTUP_UPDATE_ROOT=$RUSTUP_UPDATE_ROOT|g" \
+              build/release-ohos/build.ninja 2>/dev/null || true
+            echo "Added RUSTUP mirror config ($RUSTUP_DIST_SERVER)"
+          fi
+
+      - name: Build WebKit
+        if: steps.webkit-cache.outputs.cache-hit != 'true'
+        working-directory: bun
+        run: |
+          ninja -C build/release-ohos configure-WebKit -j1
+          ninja -C build/release-ohos/deps/WebKit jsc -j$NINJA_JOBS
+
+      - name: Build Bun
+        working-directory: bun
+        run: |
+          ninja -C build/release-ohos bun -j$NINJA_JOBS || {
+            echo "First ninja run failed (likely optional npm dep), retrying..."
+            ninja -C build/release-ohos bun -j$NINJA_JOBS
+          }
+
+      - name: Verify binary
+        working-directory: bun
+        run: |
+          file build/release-ohos/bun
+          ls -lh build/release-ohos/bun
+          file build/release-ohos/bun | grep -q "ELF.*ARM aarch64" || {
+            echo "ERROR: Not an ARM64 ELF binary"
+            file build/release-ohos/bun
+            exit 1
+          }
+          echo "Binary validation passed"
+
+      - name: Upload binary artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: bun-ohos-binary
+          path: bun/build/release-ohos/bun
+          retention-days: 7
+          if-no-files-found: error
+
+  # ──────────────────────────────────────────────────────────────────────
+  # Test job: run the test suite in an ubuntu:24.04 container with musl-tools
+  # on a github-hosted ARM runner. Downloads the binary from the build job,
+  # starts the container, installs test deps, and runs runner.node.mjs with
+  # the OHOS binary as --exec-path.
+  # ──────────────────────────────────────────────────────────────────────
+  test:
+    name: Test OHOS binary (container)
+    needs: build
+    runs-on: ubuntu-24.04-arm
+    timeout-minutes: 240
+
+    env:
+      # ubuntu:24.04 ARM64 base image + musl-tools for the musl dynamic linker.
+      # The SWR ci-runner image (used by social4hyq) requires registry auth
+      # that github-hosted runners don't have, so we use vanilla ubuntu and
+      # install musl ourselves. The OHOS binary's PT_INTERP targets
+      # /system/lib/ld-musl-aarch64.so.1 — musl-tools provides
+      # /lib/ld-musl-aarch64.so.1, we symlink.
+      CONTAINER_IMAGE: ubuntu:24.04
+      CONTAINER: ohos-fulltest
+
+    steps:
+      - name: Checkout Bun source
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 1
+
+      - name: Download OHOS binary
+        uses: actions/download-artifact@v4
+        with:
+          name: bun-ohos-binary
+          path: .bin-ohos
+
+      - name: Stage binary and verify
+        run: |
+          cp .bin-ohos/bun bun-ohos
+          chmod +x bun-ohos
+          ls -lh bun-ohos
+          file bun-ohos
+          file bun-ohos | grep -q "ELF.*ARM aarch64" || {
+            echo "ERROR: Downloaded binary is not an ARM64 ELF"
+            exit 1
+          }
+          echo "Binary staged at $(pwd)/bun-ohos"
+
+      # Free disk space on the github-hosted runner. The source tree +
+      # node_modules + container image together can exceed the runner's
+      # available space. social4hyq's workflow does the same.
+      - name: Free disk space
+        run: |
+          echo "Before cleanup:"
+          df -h / | tail -1
+          sudo rm -rf /usr/share/dotnet \
+                      /usr/local/lib/android \
+                      /opt/ghc \
+                      /opt/powershell \
+                      /usr/local/.ghcup \
+                      /opt/swift \
+                      /usr/local/swift 2>/dev/null || true
+          echo "After cleanup:"
+          df -h / | tail -1
+
+      # ── Start ubuntu container with musl support ─────────────────
+      # docker run (not GHA container:) — we need to install musl-tools and
+      # create symlinks before the test can run. We mount the workspace so
+      # the source tree, binary, and node_modules are shared.
+      # seccomp=unconfined for io_uring and other syscalls.
+      - name: Pull and start ubuntu container
+        run: |
+          docker pull "$CONTAINER_IMAGE"
+          docker run -d --name "$CONTAINER" --init \
+            --security-opt seccomp=unconfined \
+            -v "$GITHUB_WORKSPACE:/workspace/bun" \
+            "$CONTAINER_IMAGE" sleep infinity
+
+      # Install musl-tools (provides /lib/ld-musl-aarch64.so.1) and create
+      # the symlinks that match OHOS device paths. The OHOS binary's
+      # PT_INTERP targets /system/lib/ld-musl-aarch64.so.1 and
+      # /system/bin/sh — without these symlinks the binary can't start.
+      - name: Configure container (musl + symlink fixup + bun in PATH)
+        run: |
+          docker exec "$CONTAINER" bash -lc '
+            apt-get update -qq
+            apt-get install -y -qq musl-tools curl ca-certificates
+          '
+          docker exec "$CONTAINER" bash -lc \
+            'mkdir -p /data/local/tmp /system/bin /system/lib && \
+             ln -sf /bin/sh /system/bin/sh && \
+             ln -sf /lib/ld-musl-aarch64.so.1 /system/lib/ld-musl-aarch64.so.1 && \
+             chmod +x /workspace/bun/bun-ohos && \
+             ln -sf /workspace/bun/bun-ohos /usr/local/bin/bun'
+
+      # Install node via apt (runs scripts/runner.node.mjs — the test harness).
+      # Node must be stable and independent of the bun binary under test.
+      # Using NodeSource for a recent Node.js version (ubuntu 24.04 ships
+      # nodejs 18 which is too old for runner.node.mjs).
+      - name: Install node in container
+        run: |
+          docker exec "$CONTAINER" bash -lc '
+            curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
+            apt-get install -y -qq nodejs
+          '
+          docker exec "$CONTAINER" bash -lc 'node --version'
+          docker exec "$CONTAINER" bash -lc 'which node'
+
+      # Verify the OHOS binary executes inside the container. This is the
+      # critical test: if the binary can't run --version, no test can pass.
+      - name: Verify OHOS binary runs in container
+        run: |
+          docker exec "$CONTAINER" bash -lc '/workspace/bun/bun-ohos --version' \
+            || { echo "ERROR: OHOS binary failed to execute in container"; exit 1; }
+          echo "OHOS binary runs in container"
+
+      # Install test deps using the OHOS binary itself. This exercises
+      # OHOS-specific code paths in the package manager. --ignore-scripts
+      # skips postinstall scripts (puppeteer Chromium download, esbuild
+      # platform detection). Root must be installed before test/ because
+      # test/'s lockfile pins react as file:../node_modules/react.
+      - name: Install test dependencies (root + test/)
+        run: |
+          BUN=/workspace/bun/bun-ohos
+
+          echo "=== bun install (root) ==="
+          docker exec -e BUN_INSTALL_IGNORE_SCRIPTS=1 "$CONTAINER" bash -lc \
+            "cd /workspace/bun && $BUN install --ignore-scripts" 2>&1 | tail -20
+
+          echo "=== bun install (test/) ==="
+          docker exec -e BUN_INSTALL_IGNORE_SCRIPTS=1 "$CONTAINER" bash -lc \
+            "cd /workspace/bun/test && $BUN install --ignore-scripts" 2>&1 | tail -20
+
+          echo "=== verify node_modules ==="
+          docker exec "$CONTAINER" bash -lc \
+            '[ -d /workspace/bun/node_modules ] || { echo "ERROR: root node_modules missing"; exit 1; }
+             [ -d /workspace/bun/test/node_modules ] || { echo "ERROR: test/node_modules missing"; exit 1; }
+             echo "node_modules OK"'
+
+      # @esbuild/linux-arm64 is an optionalDependency filtered by {os:linux}.
+      # The OHOS bun reports process.platform="openharmony", so it skips this
+      # package. Some tests use esbuild's JS API, which needs the native
+      # binary. Force-install it if missing. The container is aarch64 musl,
+      # and @esbuild/linux-arm64 is a statically-linked Go binary that runs
+      # on musl (CGO_ENABLED=0).
+      - name: Force-install @esbuild/linux-arm64 if missing
+        run: |
+          docker exec "$CONTAINER" bash -lc '
+            ESBUILD_BIN=/workspace/bun/node_modules/@esbuild/linux-arm64/bin/esbuild
+            if [ ! -x "$ESBUILD_BIN" ]; then
+              echo "=== @esbuild/linux-arm64 missing (bun skipped: openharmony != linux), force-installing ==="
+              mkdir -p /workspace/bun/node_modules/@esbuild
+              curl -fsSL "https://registry.npmjs.org/@esbuild/linux-arm64/-/linux-arm64-0.18.6.tgz" -o /tmp/esbuild-arm64.tgz
+              mkdir -p /tmp/esbuild-arm64-x
+              tar xzf /tmp/esbuild-arm64.tgz -C /tmp/esbuild-arm64-x
+              rm -rf /workspace/bun/node_modules/@esbuild/linux-arm64
+              mv /tmp/esbuild-arm64-x/package /workspace/bun/node_modules/@esbuild/linux-arm64
+              rm -rf /tmp/esbuild-arm64.tgz /tmp/esbuild-arm64-x
+              "$ESBUILD_BIN" --version || { echo "ERROR: esbuild native binary will not execute"; exit 1; }
+              echo "=== esbuild installed ==="
+            else
+              echo "=== @esbuild/linux-arm64 already present ==="
+              "$ESBUILD_BIN" --version
+            fi
+          '
+
+      # Run the test suite. node (from NodeSource) runs runner.node.mjs,
+      # which spawns the OHOS binary at --exec-path for each test file.
+      #
+      # CI=true: test/harness.ts gates test bodies on process.env.CI
+      # (e.g. css-fuzz.test.ts runs 2600-iteration fuzz loops in non-CI
+      # mode that take hours).
+      # BUN_TEST_NO_SECRETS=1: this lane has no secret store, so
+      # getSecret() returns undefined instead of throwing.
+      # ESBUILD_BINARY_PATH: bypass esbuild's platform detection (OHOS bun
+      # reports "openharmony" which esbuild doesn't recognize). Points to
+      # the @esbuild/linux-arm64 native binary installed in the previous step.
+      # GITHUB_ACTIONS is NOT passed: runner.node.mjs has code paths that
+      # depend on GITHUB_REPOSITORY etc. when GITHUB_ACTIONS is set. Since
+      # we run via docker exec (no -e GITHUB_ACTIONS), it is absent.
+      #
+      # --retries=1 instead of the CI default of 3: the slowest remaining
+      # failures are minutes long, so 4 attempts each would cost more wall
+      # clock than the entire rest of the suite. One retry still separates
+      # a hard failure from a flake.
+      # --quiet keeps the log from ballooning over a run this long.
+      # --results-json is the artifact for follow-up triage.
+      #
+      # --exclude=bake/dev: bake.DevServer is gated by IS_CANARY || IS_DEBUG
+      # in a stable release build, so bake() is compiled off.
+      # --exclude=js/bun/ffi/cc.test.ts + regression issues: segfault in
+      # the container (no OHOS device kernel features).
+      - name: Run test suite
+        env:
+          TEST_FILTER: ${{ inputs.test-filter }}
+        run: |
+          # Build include args array for the optional test-filter input.
+          # Passed through docker exec as positional args to bash -lc.
+          INCLUDE_ARGS=()
+          if [ -n "$TEST_FILTER" ]; then
+            INCLUDE_ARGS=(--include="$TEST_FILTER")
+          fi
+
+          ESBUILD_BIN=/workspace/bun/node_modules/@esbuild/linux-arm64/bin/esbuild
+
+          set +e
+          docker exec \
+            -e CI=true \
+            -e BUN_TEST_NO_SECRETS=1 \
+            -e "ESBUILD_BINARY_PATH=$ESBUILD_BIN" \
+            "$CONTAINER" bash -lc '
+              cd /workspace/bun
+              node scripts/runner.node.mjs \
+                --exec-path=/workspace/bun/bun-ohos \
+                --quiet \
+                --retries=1 \
+                --results-json=results.json \
+                --exclude=integration/bun-types \
+                --exclude=internal/source-lints \
+                --exclude=bake/dev \
+                --exclude=js/bun/ffi/cc.test.ts \
+                --exclude=regression/issue/20144 \
+                --exclude=regression/issue/26249 \
+                "$@"
+            ' _ "${INCLUDE_ARGS[@]}"
+          RUNNER_EXIT=$?
+          set -e
+
+          echo "runner exit code: $RUNNER_EXIT"
+
+          # Copy results out of container for artifact upload
+          docker cp "$CONTAINER":/workspace/bun/results.json results.json 2>/dev/null || true
+
+          exit $RUNNER_EXIT
+
+      - name: Upload results
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: ohos-full-test-results-${{ github.run_number }}
+          path: results.json
+          retention-days: 30
+          if-no-files-found: ignore
+
+      - name: Dump container diagnostics on failure
+        if: failure()
+        run: |
+          echo "=== container status ==="
+          docker ps -a --filter "name=$CONTAINER" || true
+          echo "=== container logs (last 80 lines) ==="
+          docker logs --tail 80 "$CONTAINER" 2>&1 || true
+          echo "=== binary info ==="
+          docker exec "$CONTAINER" bash -lc 'file /workspace/bun/bun-ohos; ls -lh /workspace/bun/bun-ohos' 2>/dev/null || true
+          echo "=== node_modules check ==="
+          docker exec "$CONTAINER" bash -lc 'ls /workspace/bun/node_modules/ 2>/dev/null | head -20 || echo "no node_modules"' 2>/dev/null || true
+
+      - name: Cleanup container
+        if: always()
+        run: |
+          docker rm -f "$CONTAINER" 2>/dev/null || true
diff --git a/.github/workflows/rust-lints.yml b/.github/workflows/rust-lints.yml
index 0e7f892e30b..7c2cf6e46b2 100644
--- a/.github/workflows/rust-lints.yml
+++ b/.github/workflows/rust-lints.yml
@@ -59,10 +59,50 @@ jobs:
           ninja-targets: codegen clone-lolhtml clone-rust-argon2
 
       - name: cargo clippy
+        # `-D warnings` (set in rust:clippy) upgrades clippy warnings to
+        # errors — same ratchet as mordant's baseline: existing warnings
+        # must be fixed before new ones can be introduced.
         env:
           BUN_CODEGEN_DIR: ${{ github.workspace }}/build/debug/codegen
         run: bun run rust:clippy
 
+  clippy-ohos-target:
+    name: cargo clippy (ohos target)
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+
+      - name: Setup
+        uses: ./.github/actions/rust-lint-setup
+        with:
+          bun-version: ${{ env.BUN_VERSION }}
+          llvm-version: ${{ env.LLVM_VERSION_MAJOR }}
+          toolchain: ${{ env.RUSTUP_TOOLCHAIN }}
+          components: clippy
+          ninja-targets: codegen clone-lolhtml clone-rust-argon2
+
+      - name: Add the ohos target (Tier 2 prebuilt std)
+        run: rustup target add aarch64-unknown-linux-ohos
+
+      - name: cargo clippy (ohos target)
+        # The OHOS-gated code (cfg(target_env = "ohos")) is invisible to the
+        # host lane above; this job is its only lint gate. Workspace lints
+        # (disallowed-methods, undocumented-unsafe-blocks, ...) are deny-level
+        # via Cargo.toml, so no -D warnings needed here. Scope: -p bun_runtime
+        # covers the whole dependency chain where all OHOS-gated code lives.
+        #
+        # missing-const-for-thread-local is scoped out: it misfires on the
+        # ohos target for already-`const {}` initializers (verified:
+        # bun_alloc/ast_alloc.rs AST_ALLOC_SPARE is already `const {}` and is
+        # still flagged on the ohos target but not on host) — the host lane
+        # keeps the lint active for the same file.
+        run: |
+          cargo clippy -p bun_runtime --lib --target=aarch64-unknown-linux-ohos -- \
+            -A clippy::missing-const-for-thread-local
+
   miri:
     name: cargo miri test
     runs-on: ubuntu-latest
