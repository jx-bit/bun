index 00000000000..5d948c3a0cb
--- /dev/null
+++ b/.github/workflows/ohos-build-github.yml
@@ -0,0 +1,947 @@
+# OHOS Bun build on a GitHub-hosted ARM runner using the social4hyq OHOS
+# container (Harmonybrew musl userspace). The container provides the full
+# OHOS toolchain (llvm@21, ohos-sdk, icu4c@78, bun-webkit bottles) via brew
+# — no self-compiled __n1 cross-libs needed (replaces the fragile bare-ubuntu
+# + self-compiled __n1 path that produced a different ABI than self-hosted).
+#
+# Container approach (not GHA `container:` field): the image is a musl
+# userspace that doesn't support the glibc node runner GHA requires, so we
+# `docker run -d` + `docker exec` (same as social4hyq/homebrew-core's
+# bottle-build.yml + .github/scripts/).
+#
+# We do NOT run social4hyq's bun.rb formula (it builds social4hyq/ohos-bun
+# source, not our jy-bun). Instead: trust the tap → `brew install
+# --only-dependencies` pours the formula's deps → manually stage rust-nightly
+# (a resource, skipped by --only-dependencies) → run
+# .github/scripts/build-ohos-container.sh which replicates the formula's
+# install-block env (ohos-cross-libs/ohos-icu scaffolding, LD_LIBRARY_PATH,
+# CC/CXX) to build OUR source with --webkit=local.
+#
+# ABI: container llvm@21 cross-libs are __1 (same as self-hosted Harmonybrew).
+# After commit 6269b7c0 (deleted napi_body.rs __n1 branch) + symbols.dyn
+# local:* (only Bun__dlopen exported), v8 is not referenced → runs on device
+# (same as self-hosted).
+#
+# Signing: the release binary is PRE-SIGNED here with the ohos-selfsign CLI
+# (src/ohos_sign — pure-Rust, content-based self-signature, no cert needed).
+# Two variants ship side by side, user's choice: the raw build output stays
+# untouched as the -unsigned asset; the signed copy takes the canonical asset
+# name (recommended, runs out of the box). No install script: the tarball
+# is the whole install story (extract and run; README covers PATH).
+
+name: OHOS Build (GitHub-hosted, social4hyq container)
+
+on:
+  push:
+    branches:
+      - ohos-aarch64
+    # Tag pushes cut versioned releases from this same container lane
+    # (same build, versioned packaging — no self-hosted runner involved).
+    # Exclusions: the CI-managed rolling tags and the shared-dir build tags.
+    tags:
+      - '**'
+      - '!ohos-latest'
+      - '!latest'
+      - '!ohos-full-v*'
+    # No claude/* here: PR branches already build via the pull_request event,
+    # and listing them double-ran every PR (push + pull_request).
+  pull_request:
+    branches:
+      - ohos-aarch64
+  workflow_dispatch:
+    inputs:
+      webkit_ref:
+        description: 'WebKit fork commit (defaults to pinned WEBKIT_REF)'
+        required: false
+        default: ''
+
+concurrency:
+  group: ohos-build-github-${{ github.ref }}
+  cancel-in-progress: true
+
+permissions:
+  contents: write
+
+env:
+  # social4hyq ci-runner image (GHCR mirror of Harmonybrew SWR image).
+  # Digest-pinned (every successful run 09-02→09-07 used this digest;
+  # :latest is an untracked drift channel). Bump deliberately after
+  # validating a new image against the smoke checks.
+  OHOS_CI_IMAGE: ${{ vars.OHOS_CI_IMAGE }}
+  # Pin harmonybrew/core — the tap that owns llvm@21/ohos-sdk — to a
+  # validated commit. Floating core renamed the sysroot-bearing
+  # ohos-sdk@26.0.0.18 to the sysroot-less ohos-sdk-native on 2026-09-16
+  # (core commit 39a060948 "llvm@21: use ohos-sdk-native") and every PR
+  # went red in configure the next morning. The canary
+  # (ohos-brew-deps-canary.yml) keeps floating and validates newer core
+  # tips daily; bump this SHA only after a green canary on the new tip.
+  OHOS_CORE_PIN: 5380be4e3284cb409f6b17ba560570b217cf2707
+  # Pin the bun-formula tap the same way. The 2026-09-29 "bun14-take-over-
+  # bun-name" push (1e03f28560) added `depends_on "gcc"` to the floating
+  # bun formula; no gcc formula exists in harmonybrew/core, and brew's
+  # candidate search then loads the pinned core's ghc.rb — whose
+  # `on_catalina` DSL brew 7.x removed — so both pour attempts die at
+  # formula load. 99c90aea01 is the last tap commit validated green (#91's
+  # container run); bump only after a green canary on a newer tip.
+  OHOS_TAP_PIN: 99c90aea01c513246f215040dd9ab1a86b3daa9e
+  CONTAINER: ohos
+  TAP: ${{ vars.OHOS_TAP }}
+  # In-container tap path (baked into the ci-runner image). Used for the
+  # git safe.directory fix that `brew trust` depends on.
+  TAP_IN_CONTAINER: ${{ vars.OHOS_TAP_IN_CONTAINER }}
+  BREW_ENV: HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ANALYTICS=1 HOMEBREW_NO_ENV_HINTS=1
+  WEBKIT_FORK: oven-sh/WebKit
+  WEBKIT_REF: 2e2aa2290fac856d6f451ceacb58f7f5b44dd057
+  RUST_TOOLCHAIN: nightly-2026-07-20
+  NINJA_JOBS: 2
+
+jobs:
+  build:
+    name: Build Bun for OHOS (aarch64, social4hyq container)
+    runs-on: ubuntu-24.04-arm
+    timeout-minutes: 360
+
+    steps:
+      - name: Checkout Bun source
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      # ── Start social4hyq OHOS container ──────────────────────────
+      # docker run (not GHA container:) — musl userspace incompatible
+      # with GHA's glibc node runner. seccomp=unconfined for io_uring.
+      - name: Pull and start OHOS container
+        run: |
+          docker pull "$OHOS_CI_IMAGE"
+          docker run -d --name "$CONTAINER" --init \
+            --security-opt seccomp=unconfined \
+            -v "$GITHUB_WORKSPACE:/workspace/bun" \
+            "$OHOS_CI_IMAGE" sleep infinity
+
+      - name: Configure container (paths + cargo + tap TRUST)
+        run: |
+          # OHOS device path simulation: bun/WebKit ELFs' PT_INTERP targets
+          # real-device paths (/system/bin/sh, /system/lib/ld-musl-aarch64.so.1).
+          # musl tmpfile() also hardcodes /data/local/tmp. (social4hyq
+          # setup-container.sh lines 12-16.)
+          docker exec "$CONTAINER" bash -lc \
+            'mkdir -p /data/local/tmp /system/bin /system/lib && \
+             ln -sf /bin/sh /system/bin/sh && \
+             ln -sf /lib/ld-musl-aarch64.so.1 /system/lib/ld-musl-aarch64.so.1'
+          # cargo sparse registry + git-fetch-with-cli (social4hyq lib.sh).
+          docker exec "$CONTAINER" bash -lc \
+            'mkdir -p /root/.cargo && \
+             printf "[registries.crates-io]\nprotocol = \"sparse\"\n\n[net]\ngit-fetch-with-cli = true\nretry = 3\n" > /root/.cargo/config.toml'
+          # The tap is baked into the image at TAP_IN_CONTAINER. `brew trust`
+          # persists the tap's origin_url reference via a git query on that
+          # dir — register safe.directory first so dubious-ownership (host
+          # UID vs container root) doesn't make the query silently return nil
+          # and store a stale reference. (social4hyq setup-container.sh
+          # lines 30-94 document this exact ordering bug.)
+          docker exec "$CONTAINER" bash -lc \
+            "git config --global --add safe.directory $TAP_IN_CONTAINER || true"
+          docker exec "$CONTAINER" bash -lc "$BREW_ENV brew tap $TAP || true"
+          # CRITICAL: `brew trust` MUST run after the safe.directory fix above.
+          # Without trust, `brew install --only-dependencies social4hyq/core/bun`
+          # silently refuses to load TRANSITIVE deps from the tap
+          # (bun-bootstrap, bun-webkit — loaded via depends_on, not named on
+          # the command line, so they hit the trust check that explicitly-
+          # named formulas bypass) → "Refusing to load formula ... from
+          # untrusted tap" → ZERO deps install (brew is transactional) →
+          # openssl@3 missing → cargo "Error relocating SSL_get_error" → 127.
+          docker exec "$CONTAINER" bash -lc "$BREW_ENV brew trust $TAP"
+
+      # ── Install toolchain deps (bun formula's dependencies) ──────
+      # `brew install --only-dependencies` pours every depends_on of bun.rb
+      # (llvm@21, ohos-sdk, icu4c@78, bun-bootstrap, openssl@3, cmake, ninja,
+      # ...) without running bun's install block (we build our own source).
+      # rust-nightly is a `resource` (not a formula) — --only-dependencies
+      # skips resources, so we stage it manually in the next step.
+      - name: Install brew deps (bun formula deps only)
+        run: |
+          set -e
+          set -o pipefail
+          # pipefail above is load-bearing: the retry loop and the fallback
+          # warnings below judge `docker exec | tail` pipelines, and without
+          # it tail's exit 0 always wins — a failed pour is reported as
+          # success and the retry never fires (2026-09-14 finding).
+          # `brew update` is required: brew 7.0.6_3 resolves the bun formula's
+          # `depends_on "gcc" => :build if OS.ohos?`, the baked brew does not
+          # ("No available formula gcc" — 2026-09-29 runs). Both taps are
+          # force-pinned right after, so the update cannot drift the formulas
+          # we pour; only brew itself moves, and 7.0.6_3 is the version this
+          # lane validated green.
+          docker exec "$CONTAINER" bash -lc "$BREW_ENV brew update --quiet" \
+            || echo "::warning::brew update failed; continuing with baked index"
+          # brew update fast-forwards the baked harmonybrew/core tap to
+          # origin/main — re-pin it AFTER the update, BEFORE the pour, or the
+          # pinned SHA is silently overwritten by the update and never applies.
+          if [ -n "$OHOS_CORE_PIN" ]; then
+            docker exec -e OHOS_CORE_PIN="$OHOS_CORE_PIN" "$CONTAINER" bash -lc '
+              CORE_TAP="$(brew --repo harmonybrew/core)"
+              git -C "$CORE_TAP" fetch origin main \
+                || { echo "::error::harmonybrew/core fetch failed"; exit 1; }
+              git -C "$CORE_TAP" checkout --detach "$OHOS_CORE_PIN" \
+                || { echo "::error::harmonybrew/core pin $OHOS_CORE_PIN not fetchable (rewritten upstream?)"; exit 1; }
+              echo "=== harmonybrew/core pinned to $OHOS_CORE_PIN ==="
+            '
+          else
+            echo "::warning::OHOS_CORE_PIN unset — harmonybrew/core floats to origin/main"
+          fi
+          if [ -n "$OHOS_TAP_PIN" ]; then
+            docker exec -e OHOS_TAP_PIN="$OHOS_TAP_PIN" -e TAP="$TAP" "$CONTAINER" bash -lc '
+              TAP_DIR="$(brew --repo "$TAP")"
+              git -C "$TAP_DIR" fetch origin main \
+                || { echo "::error::$TAP fetch failed"; exit 1; }
+              git -C "$TAP_DIR" checkout --detach "$OHOS_TAP_PIN" \
+                || { echo "::error::$TAP pin $OHOS_TAP_PIN not fetchable (rewritten upstream?)"; exit 1; }
+              echo "=== $TAP pinned to $OHOS_TAP_PIN ==="
+            '
+          else
+            echo "::warning::OHOS_TAP_PIN unset — $TAP floats to origin/main"
+          fi
+          # The bun formula (99c90aea01) declares `depends_on "gcc" => :build
+          # if OS.ohos?`, but harmonybrew/core has no gcc formula — brew's
+          # candidate search then loads the pinned core's ghc.rb, whose
+          # `on_catalina` DSL brew 7.0.6_3 removed, and the pour dies at
+          # formula load. This lane builds bun with the pinned llvm@21
+          # clang, not gcc, so drop that build-dep from the pinned copy.
+          docker exec -e TAP="$TAP" "$CONTAINER" bash -lc '
+            BUN_RB="$(brew --repo "$TAP")/Formula/b/bun.rb"
+            sed -i "/depends_on .gcc. => :build if OS.ohos?/d" "$BUN_RB"
+            grep -q "depends_on .gcc." "$BUN_RB" \
+              && { echo "::error::gcc build-dep still present in $BUN_RB"; exit 1; } \
+              || echo "=== bun formula gcc build-dep dropped ==="
+          '
+          # Retry once after 90s for transient atomgit CDN 404s (social4hyq
+          # build.sh lines 41-48 — brew reuses partial work).
+          # --build-bottle (not --include-build: Harmonybrew's brew fork does
+          # not recognize --include-build) pours deps including :build ones
+          # (llvm@21, ohos-sdk, icu4c@78, bun-bootstrap, openssl@3, cmake,
+          # ninja all marked :build in bun.rb). --only-dependencies alone
+          # pours ONLY runtime deps (just `node`) → llvm@21 missing → build
+          # dies downstream. --build-bottle implies --include-build semantics;
+          # it's exactly what social4hyq build.sh uses.
+          # No --force-bottle: it is mutually exclusive with --build-bottle.
+          for i in 1 2; do
+            if docker exec "$CONTAINER" bash -lc \
+              "$BREW_ENV brew install --only-dependencies --build-bottle $TAP/bun" 2>&1 | tail -40; then
+              break
+            fi
+            [ "$i" = 2 ] && { echo "::error::brew install --only-dependencies failed after retry"; exit 1; }
+            echo "::warning::brew install attempt $i failed, retrying in 90s"
+            sleep 90
+          done
+          # 2026-09-12: upstream bun.rb dropped its direct ohos-sdk dependency
+          # (the sdk now hangs off llvm@21's deps, renamed with an @version
+          # suffix — bun.rb resolves it via
+          #   llvm.deps.find { |dep| dep.name.start_with?("ohos-sdk@") }
+          # ). --only-dependencies therefore no longer pours it, and the
+          # baked llvm@21 keg predates that transitive dep. Resolve the name
+          # from llvm@21's current formula and install it explicitly;
+          # build-ohos-container.sh resolves the same way.
+          SDK_FORMULA=$(docker exec "$CONTAINER" bash -lc "$BREW_ENV brew deps --include-build llvm@21 2>/dev/null | grep -E '^ohos-sdk' | head -1" || true)
+          SDK_FORMULA=${SDK_FORMULA:-ohos-sdk}
+          echo "sdk formula (from llvm@21 deps): $SDK_FORMULA"
+          docker exec "$CONTAINER" bash -lc "$BREW_ENV brew install $SDK_FORMULA" 2>&1 | tail -3 \
+            || echo "::warning::$SDK_FORMULA install failed — build script falls back to the legacy keg"
+          # The build driver is a prebuilt OHOS bun that drives `bun install`
+          # and the build scripts. 2026-09-26: bun-bootstrap vanished from the
+          # floating tap (upstream restructured social4hyq/core into a small
+          # OHOS-only tap; canary red since 09-22), so the lane fell back to
+          # the tap's own bun bottles — but those are a FORK: run #338 showed
+          # it ignores BUN_INSTALL_IGNORE_SCRIPTS and its rollback-on-
+          # postinstall-failure is non-deterministic (identical tree, keg and
+          # version kept the package in #333 and rolled it back in #338 an
+          # hour later). The driver is therefore SELF-HOSTED FIRST: our own
+          # verified build from the ohos-latest release asset (official
+          # lineage, honors IGNORE_SCRIPTS), downloaded runner-side and shared
+          # into the container via the workspace mount. Tap kegs remain a
+          # fallback for the day the asset URL breaks. Keg pours unset the
+          # image's baked HOMEBREW_OHOS_BOTTLE_BINARY_SIGN (the auto-sign pass
+          # corrupts bun ELFs on a re-sign) and a candidate only counts once
+          # its binary actually runs. Hard-fail here: the verify gate below
+          # would reject a driverless pour anyway, and set -e makes it stick.
+          mkdir -p "$GITHUB_WORKSPACE/.driver-bun"
+          if curl -fsSL --max-time 300 -o "$GITHUB_WORKSPACE/.driver-bun/bun" \
+              "https://github.com/jx-bit/bun/releases/download/ohos-latest/bun-ohos-aarch64-github-unsigned" \
+            && chmod +x "$GITHUB_WORKSPACE/.driver-bun/bun"; then
+            echo "self-hosted driver staged at .driver-bun/bun"
+          else
+            echo "::warning::self-hosted driver download failed — falling back to tap kegs"
+            rm -f "$GITHUB_WORKSPACE/.driver-bun/bun"
+          fi
+          docker exec -e HOMEBREW_NO_AUTO_UPDATE=1 -e HOMEBREW_NO_ANALYTICS=1 \
+            -e HOMEBREW_NO_ENV_HINTS=1 "$CONTAINER" bash -lc '
+              p=/workspace/bun/.driver-bun/bun
+              [ -x "$p" ] && "$p" --version >/dev/null 2>&1 \
+                && { echo "driver bun: self-hosted at $p"; exit 0; }
+              unset HOMEBREW_OHOS_BOTTLE_BINARY_SIGN
+              for k in bun-bootstrap bun bun@1.4; do
+                q="$(brew --prefix "$k" 2>/dev/null)/bin/bun"
+                if [ ! -x "$q" ] || ! "$q" --version >/dev/null 2>&1; then
+                  brew install --force "$k" >/dev/null 2>&1 \
+                    || brew install --force "social4hyq/core/$k" >/dev/null 2>&1 || true
+                  q="$(brew --prefix "$k" 2>/dev/null)/bin/bun"
+                fi
+                [ -x "$q" ] && "$q" --version >/dev/null 2>&1 \
+                  && { echo "driver bun keg: $k"; exit 0; }
+              done
+              echo "::error::no build driver bun (self-hosted + all kegs unusable)"; exit 1
+            '
+          # cargo (OHOS-host rust nightly) links libz. The dependency tree
+          # drifts when `brew update` refreshes the index (09-07: the pour
+          # set flipped from libedit+libffi to bzip2+libxml2 and zlib
+          # dropped out) — install it explicitly; the rust install step's
+          # LD_LIBRARY_PATH already covers $BREW_PREFIX/opt/zlib/lib.
+          docker exec "$CONTAINER" bash -lc \
+            "$BREW_ENV brew install $TAP/zlib 2>/dev/null || $BREW_ENV brew install zlib" 2>&1 | tail -3 \
+            || echo "::warning::zlib install failed — cargo will hit missing deflate/inflate symbols"
+          # lld@21 ships in harmonybrew/core, not $TAP (the 09-08 fork
+          # retirement moved it) — the old $TAP/lld@21 spelling warned "No
+          # available formula" on every run. With the 2026-09-12 bun.rb it is
+          # also a direct :build dep, so the pour above installs it; keep an
+          # unqualified fallback for older tap states.
+          docker exec "$CONTAINER" bash -lc "$BREW_ENV brew install lld@21" 2>&1 | tail -3 \
+            || echo "::warning::lld@21 install failed — ld.lld probe will reject 15.0.4"
+          # Trust rejections are SILENT (exit 0) — verify key deps actually
+          # installed, else the build fails cryptically downstream. (social4hyq
+          # build.sh lines 51-54.) zlib: cargo links it, and the pour set
+          # drifts with the formula index (see the install above). The sdk
+          # name is resolved the same way as the install above — hardcoding
+          # "ohos-sdk" broke when upstream renamed it (2026-09-14 failure).
+          # Trust rejections are SILENT (exit 0) — verify key deps actually
+          # installed, else the build fails cryptically downstream. (social4hyq
+          # build.sh lines 51-54.) zlib: cargo links it, and the pour set
+          # drifts with the formula index (see the install above). The sdk
+          # name is resolved the same way as the install above — hardcoding
+          # "ohos-sdk" broke when upstream renamed it (2026-09-14 failure).
+          # The list is a representative subset, deliberately NOT bun.rb's
+          # full --include-build tree (that spans :build deps of transitive
+          # deps — autoconf for python/ruby… — which a bottle pour never
+          # installs) and NOT JSON-derived direct deps (the image ships no
+          # jq); rename tracking is the daily canary's job.
+          docker exec -e SDK_FORMULA="$SDK_FORMULA" "$CONTAINER" bash -lc '
+            for f in llvm@21 "${SDK_FORMULA:-ohos-sdk}" icu4c@78 openssl@3 cmake ninja zlib; do
+              p=$(brew --prefix "$f" 2>/dev/null) && [ -d "$p" ] \
+                && echo "OK  $f -> $p" \
+                || { echo "::error::$f NOT installed (formula missing/renamed in the floating tap, or silent trust rejection)"; exit 1; }
+            done
+            # Build driver: the self-hosted .driver-bun staging path first
+            # (deterministic — see the install step above), tap kegs as
+            # fallback. A candidate only counts once its binary actually runs.
+            driver=""
+            for p in /workspace/bun/.driver-bun/bun \
+                     "$(brew --prefix bun-bootstrap 2>/dev/null)/bin/bun" \
+                     "$(brew --prefix bun 2>/dev/null)/bin/bun" \
+                     "$(brew --prefix bun@1.4 2>/dev/null)/bin/bun"; do
+              [ -x "$p" ] && "$p" --version >/dev/null 2>&1 && { driver="$p"; break; }
+            done
+            [ -n "$driver" ] \
+              || { echo "::error::no runnable build driver bun (self-hosted + all kegs unusable)"; exit 1; }
+            echo "OK  driver bun -> $driver ($("$driver" --version 2>/dev/null | head -1))"
+            # Keg existence is not enough: a renamed sdk keg without
+            # native/sysroot passes the loop above and dies 6 minutes later in
+            # configure (2026-09-17). Assert the sysroot layout itself.
+            sysroot=""
+            for d in "$(brew --prefix)"/opt/ohos-sdk*/; do
+              [ -d "${d}native/sysroot" ] && { sysroot="${d}native/sysroot"; break; }
+            done
+            [ -n "$sysroot" ] \
+              || { echo "::error::no ohos-sdk* keg carries native/sysroot (SDK layout drift)"; exit 1; }
+            echo "OK  sysroot -> $sysroot"
+            echo "=== clang ==="; $(brew --prefix llvm@21)/bin/clang --version | head -1
+            echo "=== openssl@3 lib ==="; ls "$(brew --prefix openssl@3)/lib"/libssl* 2>/dev/null | head -3
+          '
+
+      # ── Install rust-nightly (resource, not a brew formula) ──────
+      # bun.rb's install block stages this resource to /data/storage/el2/base/tmp.
+      # --only-dependencies skips the install block, so we do it manually.
+      # musl Rust host (aarch64-unknown-linux-ohos) for -Zbuild-std.
+      # No ELF signing: the container runs a Linux kernel (not OHOS), so
+      # unsigned cargo execs fine — the musl loader does not check .codesign
+      # (confirmed empirically: cargo reached symbol-relocation before failing
+      # on OpenSSL, not an exec-refusal/signing error).
+      - name: Install rust-nightly (OHOS musl host)
+        run: |
+          docker exec -e RUST_TOOLCHAIN="$RUST_TOOLCHAIN" "$CONTAINER" bash -lc '
+            RUST_HOME="/data/storage/el2/base/tmp/rust-${RUST_TOOLCHAIN}"
+            if [ ! -f "$RUST_HOME/BREW_SIGNED_OK" ]; then
+              echo "=== downloading rust-nightly ${RUST_TOOLCHAIN} ==="
+              curl -fsSL "https://static.rust-lang.org/dist/2026-07-20/rust-nightly-aarch64-unknown-linux-ohos.tar.gz" -o /tmp/rust-host.tar.gz
+              tar xf /tmp/rust-host.tar.gz -C /tmp
+              sh /tmp/rust-nightly-aarch64-unknown-linux-ohos/install.sh --prefix="$RUST_HOME" --disable-ldconfig
+              echo "=== downloading rust-src ==="
+              curl -fsSL "https://static.rust-lang.org/dist/2026-07-20/rust-src-nightly.tar.gz" -o /tmp/rust-src.tar.gz
+              tar xf /tmp/rust-src.tar.gz -C /tmp
+              sh /tmp/rust-src-nightly/install.sh --prefix="$RUST_HOME" --disable-ldconfig
+              rm -rf /tmp/rust-*.tar.gz /tmp/rust-nightly-* /tmp/rust-src-nightly
+              touch "$RUST_HOME/BREW_SIGNED_OK"
+              echo "=== rust installed to $RUST_HOME ==="
+            else
+              echo "=== rust already installed ==="
+            fi
+            # cargo links libssl/libcrypto/libz (git2/registry transport);
+            # rustc does NOT — that is why `rustc --version` passed while
+            # `cargo --version` hit "Error loading shared library libssl.so"
+            # → "Error relocating cargo: SSL_get_error: symbol not found" → 127.
+            # Same LD_LIBRARY_PATH the build script sets later, but the cargo
+            # verification below runs BEFORE that script — inject here too.
+            # (bun.rb lines 195-199 document this exact cargo/openssl failure.)
+            # Paths use opt/<name>/lib (formula_opt_lib), NOT lib/<name>/lib.
+            BREW_PREFIX=$(brew --prefix)
+            export LD_LIBRARY_PATH="$BREW_PREFIX/opt/openssl@3/lib:$BREW_PREFIX/opt/libxml2/lib:$BREW_PREFIX/opt/zlib/lib:${LD_LIBRARY_PATH:-}"
+            "$RUST_HOME/bin/rustc" --version
+            "$RUST_HOME/bin/cargo" --version
+          '
+
+      # ── WebKit fork (pinned, --webkit=local) ─────────────────────
+      - name: Checkout WebKit fork (pinned)
+        run: |
+          WK_REF="${{ inputs.webkit_ref || env.WEBKIT_REF }}"
+          echo "WebKit ref: $WK_REF"
+          rm -rf vendor/WebKit
+          mkdir -p vendor/WebKit
+          cd vendor/WebKit
+          git init
+          git remote add origin https://github.com/${{ env.WEBKIT_FORK }}.git
+          git fetch --depth 1 origin "$WK_REF"
+          git checkout FETCH_HEAD
+          echo "=== vendor/WebKit HEAD ==="
+          git rev-parse HEAD
+
+      - name: Extract WebKit version for cache key
+        id: webkit-version
+        run: |
+          WK_VER=$(grep "^export const WEBKIT_VERSION" scripts/build/deps/webkit.ts | grep -oE '[a-f0-9]{40}')
+          echo "version=${WK_VER}" >> "$GITHUB_OUTPUT"
+
+      - name: Cache WebKit build
+        uses: actions/cache@v4
+        id: webkit-cache
+        with:
+          path: build/release-ohos/deps/WebKit
+          key: webkit-ohos-container-${{ inputs.webkit_ref || env.WEBKIT_REF }}-${{ steps.webkit-version.outputs.version }}-abi-n1
+
+      - name: Cache __n1 cross-libs
+        uses: actions/cache@v4
+        id: cross-libs-cache
+        with:
+          path: build/ohos-cross-libs
+          key: ohos-libcxx-n1-llvm21.1.8-1
+
+      # ── bun install (root + node-fallbacks) ──────────────────────
+      # BUN_INSTALL_IGNORE_SCRIPTS=1 skips esbuild's postinstall (install.js),
+      # which throws "Unsupported platform: openharmony" — esbuild's install.js
+      # uses process.platform, and OHOS node reports "openharmony". That failure
+      # is benign: build-ohos-container.sh bypasses platform detection later via
+      # ESBUILD_BINARY_PATH. But it makes `bun install` exit non-zero, and the
+      # pipe to tail would mask that exit code — so verify the critical packages
+      # (esbuild, lezer-cpp for cppbind) actually landed in node_modules.
+      - name: bun install (root + node-fallbacks)
+        run: |
+          # Same driver candidates as the install/verify steps above
+          # (.driver-bun first), gated on the binary actually running.
+          # LD_LIBRARY_PATH mirrors build-ohos-container.sh: the driver needs
+          # brew libs on the loader path and this step runs before that script.
+          BUN_DIR=$(docker exec "$CONTAINER" bash -lc '
+            for p in /workspace/bun/.driver-bun \
+                     "$(brew --prefix bun-bootstrap 2>/dev/null)/bin" \
+                     "$(brew --prefix bun 2>/dev/null)/bin" \
+                     "$(brew --prefix bun@1.4 2>/dev/null)/bin"; do
+              [ -x "$p/bun" ] && "$p/bun" --version >/dev/null 2>&1 && { echo "$p"; exit 0; }
+            done
+            echo "::error::no runnable build driver bun" >&2; exit 1
+          ') || { echo "::error::driver bun resolution failed"; exit 1; }
+          BUN="$BUN_DIR/bun"
+          echo "driver bun: $BUN"
+          BREW_PREFIX=$(docker exec "$CONTAINER" bash -lc 'brew --prefix')
+          export LD_LIBRARY_PATH="$BREW_PREFIX/opt/openssl@3/lib:$BREW_PREFIX/opt/libxml2/lib:$BREW_PREFIX/opt/zlib/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
+          docker exec -e LD_LIBRARY_PATH -e BUN_INSTALL_IGNORE_SCRIPTS=1 "$CONTAINER" bash -lc "cd /workspace/bun && $BUN install" 2>&1 | tail -30
+          docker exec -e LD_LIBRARY_PATH -e BUN_INSTALL_IGNORE_SCRIPTS=1 "$CONTAINER" bash -lc "cd /workspace/bun/src/node-fallbacks && $BUN install" 2>&1 | tail -30
+          # Verify deps actually installed (the | tail above masks the exit code;
+          # esbuild postinstall may have failed without aborting the step).
+          docker exec "$CONTAINER" bash -lc '
+            [ -d /workspace/bun/node_modules/esbuild ] || { echo "ERROR: esbuild not installed"; exit 1; }
+            [ -d /workspace/bun/node_modules/lezer-cpp ] || echo "WARN: lezer-cpp missing (cppbind codegen may fail)"
+            echo "=== node_modules populated ==="
+          '
+
+      # ── Scaffold cross-libs + ICU + Configure + build ────────────
+      # Delegates to .github/scripts/build-ohos-container.sh (replicates
+      # social4hyq bun.rb's install-block env). Host vars passed via -e.
+      # GITHUB_SHA: the container has no git (Harmonybrew musl), so config.ts's
+      # getGitRevision() can't `git rev-parse HEAD` and would return "unknown"
+      # (7 chars). That feeds build_options::SHA, and env.rs:58 does
+      # const_str_slice(SHA, 0, 9) → split_at(9) panics "mid > len" (E0080).
+      # getGitRevision checks GITHUB_SHA first (config.ts:1526), so passing it
+      # in gives the full 40-char commit directly.
+      - name: Scaffold + Configure + build Bun for OHOS
+        run: |
+          set -e
+          docker exec -e RUST_TOOLCHAIN="$RUST_TOOLCHAIN" -e NINJA_JOBS="$NINJA_JOBS" \
+            -e GITHUB_SHA="$GITHUB_SHA" -e GIT_SHA="$GITHUB_SHA" \
+            "$CONTAINER" bash /workspace/bun/.github/scripts/build-ohos-container.sh
+
+      # ── Copy binary out + verify ─────────────────────────────────
+      - name: Copy binary + build log out of container
+        if: always()
+        run: |
+          mkdir -p build/release-ohos
+          docker cp "$CONTAINER":/workspace/bun/build/release-ohos/bun build/release-ohos/bun 2>/dev/null || \
+            docker cp "$CONTAINER":/workspace/bun/build/release-ohos/bun-profile build/release-ohos/bun 2>/dev/null || \
+            echo "::warning::no bun binary found to copy out"
+          docker cp "$CONTAINER":/tmp/build.log /tmp/build.log 2>/dev/null || true
+
+      - name: Verify binary
+        if: success()
+        run: |
+          set -e
+          OUT=build/release-ohos/bun
+          echo "=== binary ==="
+          ls -lh "$OUT"
+          file "$OUT"
+          file "$OUT" | grep -iqE "ELF.*(arm64|aarch64)" || { echo "ERROR: not ARM64 ELF"; exit 1; }
+          echo "=== NEEDED libs ==="
+          readelf -d "$OUT" 2>/dev/null | grep NEEDED || true
+          # v8 symbols are DEFINED in bun's C++ V8 compat layer (not UND).
+          # v8 UND must be 0 — otherwise the device tries to resolve v8
+          # against its libc++_shared.so and crashes on ABI mismatch.
+          echo "=== v8 undefined symbols (want 0) ==="
+          v8_und=$(readelf --dyn-syms "$OUT" 2>/dev/null | grep -c "_ZN2v8.*UND" || true)
+          echo "v8 UND = $v8_und"
+          [ "$v8_und" -eq 0 ] || { echo "ERROR: v8 UND symbols present"; exit 1; }
+          echo "=== exported symbol count ==="
+          readelf --dyn-syms "$OUT" 2>/dev/null | grep -c "GLOBAL.*T " || true
+          echo "=== sample exported symbols ==="
+          readelf --dyn-syms "$OUT" 2>/dev/null | grep -E "GLOBAL.*T " | head -5
+          echo "=== validation OK ==="
+
+      # ── Pre-sign the release binary (variant copy) ───────────────
+      # ohos-selfsign (src/ohos_sign, std-only Rust) writes the .codesign
+      # section the OHOS kernel validates at exec: same bytes the device-side
+      # binary-sign-tool produces. Built OUTSIDE the workspace (see step
+      # body): configure generates .cargo/config.toml with a container-only
+      # linker that does not exist on this runner.
+      - name: Pre-sign binary (out-of-the-box release assets)
+        if: success()
+        run: |
+          set -e
+          # docker cp preserves the container's root ownership; this hosted
+          # runner is non-root, so the signer's write into build/release-ohos/
+          # needs the tree normalized first (the self-hosted runner ran as
+          # root and never hit this).
+          sudo chown -R "$(id -u):$(id -g)" build/release-ohos 2>/dev/null || true
+          SIGNER=/tmp/ohos-selfsign
+          if [ ! -x "$SIGNER" ]; then
+            if ! command -v cargo >/dev/null 2>&1; then
+              curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
+              export PATH="$HOME/.cargo/bin:$PATH"
+            fi
+            # Standalone copy: configure generates .cargo/config.toml with a
+            # container-only linker (Harmonybrew llvm@21) absent on this
+            # runner; outside the workspace cargo uses the default linker.
+            # The crate has zero dependencies — no registry access needed.
+            rm -rf /tmp/ohos_sign-build
+            cp -r src/ohos_sign /tmp/ohos_sign-build
+            (cd /tmp/ohos_sign-build && cargo build --release --bin ohos-selfsign)
+            cp /tmp/ohos_sign-build/target/release/ohos-selfsign "$SIGNER"
+          fi
+          # --force: strip + re-sign if a stale section ever sneaks in (idempotent).
+          "$SIGNER" sign --force --output build/release-ohos/bun-signed build/release-ohos/bun
+          # Kernel-equivalent gate (file_size + merkle root recompute), not
+          # just section presence — an invalid descriptor must fail here,
+          # not on devices as EACCES.
+          "$SIGNER" verify build/release-ohos/bun-signed
+          echo "✅ signed variant ready (unsigned build output kept alongside)"
+
+      - name: Prepare github-hosted release asset
+        if: success()
+        id: gh_release
+        run: |
+          BIN=build/release-ohos/bun
+          BIN_SIGNED=build/release-ohos/bun-signed
+          test -f "$BIN_SIGNED" || { echo "FATAL: no signed bun binary to release (Pre-sign step missing?)"; exit 1; }
+          VERSION=$(python3 -c "import json; print(json.load(open('package.json'))['version'])")
+          COMMIT=$(git rev-parse --short HEAD)
+          # Two OHOS assets, user's choice: the pre-signed tarball (primary,
+          # extract and run) and the raw unsigned build output (sign yourself
+          # on device). The tarball extracts to a versioned directory —
+          # README covers run/PATH/corruption diagnosis.
+          cp "$BIN" /tmp/bun-ohos-aarch64-github-unsigned
+          TARBALL_NAME="bun-ohos-aarch64-github-${VERSION}"
+          mkdir -p "/tmp/bun-tarball/$TARBALL_NAME"
+          cp "$BIN_SIGNED" "/tmp/bun-tarball/$TARBALL_NAME/bun"
+          cat > "/tmp/bun-tarball/$TARBALL_NAME/README.md" << 'EOF'
+          # Bun for HarmonyOS (OHOS) aarch64
+
+          The bundled bun is pre-signed — run it directly:
+
+              chmod +x bun && ./bun --version
+
+          Optional — add to PATH for the current session:
+
+              export PATH="$PWD:$PATH"
+
+          If exec fails with "Permission denied" after `chmod +x bun`, the
+          archive was corrupted — re-download it (the embedded signature is
+          what the kernel validates at exec).
+          EOF
+          tar czf "/tmp/$TARBALL_NAME.tar.gz" -C /tmp/bun-tarball "$TARBALL_NAME"
+          rm -rf /tmp/bun-tarball
+          {
+            echo "unsigned_asset_path=/tmp/bun-ohos-aarch64-github-unsigned"
+            echo "tar_path=/tmp/$TARBALL_NAME.tar.gz"
+            echo "tar_name=$TARBALL_NAME"
+            echo "body_path=/tmp/release-body.md"
+            echo "commit=$COMMIT"
+          } >> "$GITHUB_OUTPUT"
+          {
+            echo '## Latest Bun for HarmonyOS (OHOS) aarch64'
+            echo ''
+            echo 'This release is automatically updated with the latest build.'
+            echo ''
+            echo '### Disclaimer'
+            echo ''
+            echo '本项目为非官方社区项目，由社区开发者共同维护。'
+            echo 'This is a non-official community project maintained by community developers.'
+            echo ''
+            echo '### Known Limitations'
+            echo ''
+            echo 'Due to HarmonyOS system restrictions (sandboxing, code signing, kernel differences), some features are missing or degraded — see the release notes above for details.'
+          echo ''
+            echo '### Quick Install (OHOS device)'
+            echo ''
+            echo 'Pre-signed tarball — extract and run, no signing needed:'
+            echo ''
+            echo '```bash'
+            echo "curl -fsSL -o bun.tar.gz https://github.com/jx-bit/bun/releases/download/ohos-latest/$TARBALL_NAME.tar.gz"
+            echo "tar xzf bun.tar.gz && ./$TARBALL_NAME/bun --version"
+            echo '```'
+            echo ''
+            echo ''
+            echo '### Release Notes'
+            echo ''
+            echo '[详细说明（发布后可持续更新）](https://github.com/jx-bit/bun/blob/release-docs/releases/ohos-latest/README.md)'
+            echo ''
+            echo '### Version'
+            echo ''
+            echo "Built from: v$VERSION @$COMMIT (ohos-aarch64)"
+            echo ''
+          } > /tmp/release-body.md
+          echo "✅ Release assets: bun-ohos-aarch64-github-unsigned + $TARBALL_NAME.tar.gz (v$VERSION @ $COMMIT)"
+
+      - name: Seed release-docs placeholder
+        # Same contract as the tag-release flow: the ohos-latest body links
+        # to releases/ohos-latest/README.md on release-docs — seed a rolling
+        # placeholder once (idempotent; developer edits afterwards via direct
+        # push). Re-probes before re-creating to cover transient
+        # contents-API 5xx.
+        if: success() && github.ref == 'refs/heads/ohos-aarch64'
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          DOC="releases/ohos-latest/README.md"
+          PLACEHOLDER='# ohos-latest（滚动发布线）
+
+          > 占位文档 —— 发布流水线自动生成，等待开发者补充。
+          > 此文档描述滚动线的当前状态（在途变更、已知问题等），
+          > 直接编辑并 push 到 `release-docs` 分支，
+          > release 页面的链接会自动显示最新内容。
+
+          ## 已知限制
+
+          （鸿蒙系统限制导致的功能缺失/降级，具体条目……）'
+          for attempt in 1 2 3; do
+            if gh api "repos/${{ github.repository }}/contents/${DOC}?ref=release-docs" >/dev/null 2>&1; then
+              echo "✅ ${DOC} already exists — untouched"
+              exit 0
+            fi
+            if gh api --method PUT "repos/${{ github.repository }}/contents/${DOC}" \
+                -f message="docs: seed placeholder for ohos-latest" \
+                -f branch=release-docs \
+                -f content="$(printf '%s\n' "$PLACEHOLDER" | base64 -w0)" >/dev/null 2>&1; then
+              echo "✅ seeded ${DOC}"
+              exit 0
+            fi
+            echo "⚠️ attempt ${attempt} failed, retrying..."
+            [ "$attempt" = 3 ] || sleep $((5 * attempt))
+          done
+          echo "❌ could not seed ${DOC} after 3 attempts"
+          exit 1
+
+      - name: Upload binary artifact
+        if: success()
+        uses: actions/upload-artifact@v4
+        with:
+          name: bun-ohos-aarch64-github
+          path: |
+            build/release-ohos/bun
+            build/release-ohos/bun-signed
+          retention-days: 90
+
+      - name: Upload github-hosted binary to ohos-latest release
+        # Only the delivery branch publishes the rolling release — PR gates
+        # must not overwrite ohos-latest.
+        if: success() && github.ref == 'refs/heads/ohos-aarch64'
+        uses: softprops/action-gh-release@v2
+        with:
+          tag_name: ohos-latest
+          name: "Bun OHOS (Latest)"
+          body_path: /tmp/release-body.md
+          files: |
+            ${{ steps.gh_release.outputs.unsigned_asset_path }}
+            ${{ steps.gh_release.outputs.tar_path }}
+        env:
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Verify ohos-latest release assets
+        # Publish gate: the tarball one-liner target must exist — all
+        # assets uploaded.
+        if: success() && github.ref == 'refs/heads/ohos-aarch64'
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          for asset in "bun-ohos-aarch64-github-unsigned" "${{ steps.gh_release.outputs.tar_name }}.tar.gz"; do
+            gh release view ohos-latest --repo "${{ github.repository }}" \
+              --json assets --jq '.assets[].name' | grep -qx -F "$asset" || {
+              echo "❌ asset '$asset' missing from ohos-latest"; exit 1; }
+          done
+          gh api "repos/${{ github.repository }}/contents/releases/ohos-latest/README.md?ref=release-docs" >/dev/null 2>&1 \
+            || { echo "❌ release-docs placeholder missing for ohos-latest"; exit 1; }
+          echo "✅ ohos-latest verified: install one-liner target + release-docs placeholder present"
+
+      - name: Dump failure diagnostics
+        if: failure()
+        run: |
+          echo "=== first errors in build.log ==="
+          grep -inE 'error\[|error:|fatal error|undefined reference|ld: error|FAILED:|Error relocating|Refusing to load|No available formula' /tmp/build.log 2>/dev/null | head -50 || true
+          echo "=== last 100 lines of build.log ==="
+          tail -100 /tmp/build.log 2>/dev/null || echo "(no build.log — failed before configure step; check step output above)"
+          echo "=== brew trust state ==="
+          docker exec "$CONTAINER" bash -lc "$BREW_ENV brew tap && $BREW_ENV brew trust 2>&1 || true" || true
+
+      - name: Upload build log
+        if: failure()
+        uses: actions/upload-artifact@v4
+        with:
+          name: ohos-build-log
+          path: /tmp/build.log
+          if-no-files-found: ignore
+          retention-days: 7
+
+  # ─── Cross-compile legs: linux-x64 / linux-arm64 / windows-x64 / darwin-arm64 ───
+  # Runs in PARALLEL with `build` — the five targets are independent builds of
+  # the same commit; the cross legs need no container and no sysroot download
+  # (linux-arm64 is native on the arm64 host). Reusable-workflow call keeps
+  # cross-x86.yml dispatchable standalone.
+  cross:
+    name: Cross-compile (4 targets)
+    if: github.event_name == 'push'
+    uses: ./.github/workflows/cross-x86.yml
+    with:
+      sha: ${{ github.sha }}
+    secrets: inherit
+
+  # ─── Multi-product rolling latest ───
+  # Collects the five products from this run and publishes them to one
+  # rolling `latest` release whose body names the baseline commit. Separate
+  # from the OHOS-only `ohos-latest` release published by the `build` job.
+  publish:
+    name: Publish multi-product release
+    needs: [build, cross]
+    # Branch pushes to the delivery line publish the rolling `latest`;
+    # tag pushes publish a versioned release with the identical product
+    # set. Same build, same packaging — only the release target differs.
+    if: github.event_name == 'push' && (github.ref == 'refs/heads/ohos-aarch64' || startsWith(github.ref, 'refs/tags/'))
+    runs-on: ubuntu-24.04-arm
+    timeout-minutes: 15
+    env:
+      RELEASE_TARGET: ${{ github.ref == 'refs/heads/ohos-aarch64' && 'latest' || github.ref_name }}
+    steps:
+      - name: Checkout Bun source
+        # Stage the installer from the same commit as the built products —
+        # script/binary pairing for THIS release.
+        uses: actions/checkout@v4
+
+      - name: Download products (same run, one directory per artifact)
+        # upload-artifact@v4 stores `path` entries at the artifact ROOT by
+        # basename (build/release-ohos/bun → root `bun`; the pre-sign step
+        # adds `bun-signed`), so every linux/darwin artifact is a file
+        # literally named `bun`. merge-multiple would extract them all into
+        # one directory and each artifact would overwrite the previous —
+        # download each into its own subdirectory instead.
+        uses: actions/download-artifact@v4
+        with:
+          name: bun-ohos-aarch64-github
+          path: dist/ohos
+
+      - name: Download cross products (same run, one directory per artifact)
+        uses: actions/download-artifact@v4
+        with:
+          pattern: bun-cross-*
+          path: dist-cross
+
+      - name: Stage products
+        run: |
+          mkdir -p products
+          # OHOS artifact holds both variants: bun-signed goes into the
+          # pre-signed tarball (the install story), the raw build output
+          # ships as the -unsigned variant.
+          cp dist/ohos/bun                              products/bun-ohos-aarch64-unsigned
+          cp dist-cross/bun-cross-linux-x64/bun         products/bun-linux-x64
+          cp dist-cross/bun-cross-linux-arm64/bun       products/bun-linux-arm64
+          cp dist-cross/bun-cross-windows-x64/bun.exe   products/bun-windows-x64.exe
+          cp dist-cross/bun-cross-darwin-arm64/bun      products/bun-darwin-arm64
+          # Pre-signed tarball (extract and run), same shape as the OHOS
+          # rolling page: signed bun + README.
+          VERSION=$(python3 -c "import json; print(json.load(open('package.json'))['version'])")
+          TARBALL_NAME="bun-ohos-aarch64-${VERSION}"
+          mkdir -p "bun-tarball/$TARBALL_NAME"
+          cp dist/ohos/bun-signed "bun-tarball/$TARBALL_NAME/bun"
+          cat > "bun-tarball/$TARBALL_NAME/README.md" << 'EOF'
+          # Bun for HarmonyOS (OHOS) aarch64
+
+          The bundled bun is pre-signed — run it directly:
+
+              chmod +x bun && ./bun --version
+
+          Optional — add to PATH for the current session:
+
+              export PATH="$PWD:$PATH"
+
+          If exec fails with "Permission denied" after `chmod +x bun`, the
+          archive was corrupted — re-download it (the embedded signature is
+          what the kernel validates at exec).
+          EOF
+          tar czf "products/$TARBALL_NAME.tar.gz" -C bun-tarball "$TARBALL_NAME"
+          rm -rf bun-tarball
+          ls -la products/
+
+      - name: Generate release body
+        # Same layout as every other release page: Quick Install, Products,
+        # Release Notes (the release-docs placeholder is seeded below).
+        run: |
+          SHA='${{ github.sha }}'
+          BODY=/tmp/release-body.md
+          # Tarball name from the staged file (not recomputed) so the body
+          # command always matches the uploaded asset.
+          TARBALL_NAME=$(basename products/bun-ohos-aarch64-*.tar.gz .tar.gz)
+          {
+            printf 'Products built from the same baseline commit `%s` (ohos-aarch64).\n\n' "$SHA"
+            echo '### Disclaimer'
+            echo ''
+            echo '本项目为非官方社区项目，由社区开发者共同维护。'
+            echo 'This is a non-official community project maintained by community developers.'
+            echo ''
+            echo '### Known Limitations'
+            echo ''
+            echo 'Due to HarmonyOS system restrictions (sandboxing, code signing, kernel differences), some features are missing or degraded — see the release notes above for details.'
+          echo ''
+            echo '### Quick Install (OHOS device)'
+            echo ''
+            echo 'Pre-signed tarball — extract and run, no signing needed:'
+            echo ''
+            echo '```bash'
+            echo "curl -fsSL -o bun.tar.gz https://github.com/jx-bit/bun/releases/download/$RELEASE_TARGET/$TARBALL_NAME.tar.gz"
+            echo "tar xzf bun.tar.gz && ./$TARBALL_NAME/bun --version"
+            echo '```'
+            echo ''
+            echo ''
+            echo '### Products'
+            echo ''
+            echo '| File | Target | Build | Size |'
+            echo '|---|---|---|---|'
+            for f in products/*; do
+              name=$(basename "$f")
+              size=$(du -h "$f" | cut -f1)
+              case "$name" in
+                bun-ohos-aarch64-unsigned) target='OHOS (HarmonyOS) aarch64'; build='container lane (no .codesign)' ;;
+                *.tar.gz)            target='OHOS (HarmonyOS) aarch64'; build='container lane (pre-signed tarball)' ;;
+                bun-linux-x64)       target='Linux x86_64 (glibc)';    build='cross (aarch64 host)' ;;
+                bun-linux-arm64)     target='Linux arm64 (glibc)';     build='native (arm64 host)' ;;
+                bun-windows-x64.exe) target='Windows x86_64';          build='cross' ;;
+                bun-darwin-arm64)    target='macOS arm64';             build='cross' ;;
+                *)                   target='?';                       build='?' ;;
+              esac
+              printf '| %s | %s | %s | %s |\n' "$name" "$target" "$build" "$size"
+            done
+            echo ''
+            echo '### Release Notes'
+            echo ''
+            echo "[详细说明（发布后可持续更新）](https://github.com/jx-bit/bun/blob/release-docs/releases/$RELEASE_TARGET/README.md)"
+            echo ''
+          } > "$BODY"
+
+      - name: Seed release-docs placeholder
+        # Same contract as the other flows: the latest body links to
+        # releases/$RELEASE_TARGET/README.md on release-docs — seed the rolling
+        # (latest) or versioned (tag) placeholder, idempotent —
+        # placeholder once (idempotent; developer edits afterwards).
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          DOC="releases/$RELEASE_TARGET/README.md"
+          PLACEHOLDER="# $RELEASE_TARGET（OHOS 发布线）
+
+          > 占位文档 —— 发布流水线自动生成，等待开发者补充。
+          > 此文档描述滚动线的当前状态（在途变更、已知问题等），
+          > 直接编辑并 push 到 \`release-docs\` 分支，
+          > release 页面的链接会自动显示最新内容。
+
+          ## 已知限制
+
+          （鸿蒙系统限制导致的功能缺失/降级，具体条目……）"
+          for attempt in 1 2 3; do
+            if gh api "repos/${{ github.repository }}/contents/${DOC}?ref=release-docs" >/dev/null 2>&1; then
+              echo "✅ ${DOC} already exists — untouched"
+              exit 0
+            fi
+            if gh api --method PUT "repos/${{ github.repository }}/contents/${DOC}" \
+                -f message="docs: seed placeholder for $RELEASE_TARGET" \
+                -f branch=release-docs \
+                -f content="$(printf '%s\n' "$PLACEHOLDER" | base64 -w0)" >/dev/null 2>&1; then
+              echo "✅ seeded ${DOC}"
+              exit 0
+            fi
+            echo "⚠️ attempt ${attempt} failed, retrying..."
+            [ "$attempt" = 3 ] || sleep $((5 * attempt))
+          done
+          echo "❌ could not seed ${DOC} after 3 attempts"
+          exit 1
+
+      - name: Publish release
+        env:
+          GH_TOKEN: ${{ github.token }}
+          # Same file the Generate release body step writes above.
+          BODY: /tmp/release-body.md
+        run: |
+          TITLE="Bun OHOS Cross-Build (latest)"
+          [ "$RELEASE_TARGET" = "latest" ] || TITLE="Bun OHOS $RELEASE_TARGET"
+          if [ "$RELEASE_TARGET" = "latest" ]; then
+            if gh release view "$RELEASE_TARGET" --repo "${{ github.repository }}" > /dev/null 2>&1; then
+              gh release upload latest products/* --repo "${{ github.repository }}" --clobber
+              gh release edit latest --repo "${{ github.repository }}" \
+                --notes-file "$BODY" --title "$TITLE"
+            else
+              gh release create latest products/* --repo "${{ github.repository }}" \
+                --title "$TITLE" --notes-file "$BODY"
+            fi
+          else
+            gh release create "$RELEASE_TARGET" products/* --repo "${{ github.repository }}" \
+              --title "$TITLE" --notes-file "$BODY"
+          fi
+
+      - name: Verify latest release assets
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          TAR_NAME=$(basename products/bun-ohos-aarch64-*.tar.gz)
+          for product in bun-ohos-aarch64-unsigned "$TAR_NAME" bun-linux-x64 bun-linux-arm64 bun-windows-x64.exe bun-darwin-arm64; do
+            gh release view "$RELEASE_TARGET" --repo "${{ github.repository }}" \
+              --json assets --jq '.assets[].name' | grep -qx -F "$product" || {
+              echo "❌ product '$product' missing from latest"; exit 1; }
+          done
+          gh api "repos/${{ github.repository }}/contents/releases/$RELEASE_TARGET/README.md?ref=release-docs" >/dev/null 2>&1 \
+            || { echo "❌ release-docs placeholder missing for $RELEASE_TARGET"; exit 1; }
+          echo "✅ $RELEASE_TARGET: 4 platform products + OHOS unsigned variant + pre-signed tarball + release-docs placeholder verified"
diff --git a/.github/workflows/ohos-build-rust.yml b/.github/workflows/ohos-build-rust.yml
new file mode 100644
index 00000000000..ce52c8b9ae8
--- /dev/null
+++ b/.github/workflows/ohos-build-rust.yml
@@ -0,0 +1,378 @@
+# Bun OHOS Rust Build CI
+#
+# Incremental Rust-based build for HarmonyOS (OHOS) aarch64.
+# Uses cargo's incremental compilation + sccache for fast rebuilds.
+# WebKit is cached between runs.
+#
+# Required runner environment:
+#   - OHOS SDK at /home/user/setup-ohos-sdk/
+#   - LLVM 22 toolchain (musl-compatible)
+#   - Cross-compiled ICU at bun/build/ohos-icu/
+#   - Cross-compiled libc++ at bun/build/ohos-cross-libs/
+#   - sccache (optional, for Rust compilation caching)
+#
+# Build directory: build/release-ohos/ (isolated from native release builds)
+
+name: OHOS Rust Build
+on:
+  push:
+    branches:
+      - ohos-aarch64
+    # No claude/* here: PR branches already build via the pull_request event,
+    # and listing them double-ran every PR (push + pull_request).
+    paths:
+      - 'scripts/build/**'
+      - 'src/**/*.rs'
+      - 'src/**/*.cpp'
+      - 'src/**/*.h'
+      - 'Cargo.toml'
+      - 'Cargo.lock'
+      - 'rust-toolchain.toml'
+      - 'vendor/WebKit/**'
+      - 'patches/**'
+      - '.github/workflows/ohos-build-rust.yml'
+  pull_request:
+    branches:
+      - ohos-aarch64
+    paths:
+      - 'scripts/build/**'
+      - 'src/**/*.rs'
+      - 'src/**/*.cpp'
+      - 'src/**/*.h'
+      - 'Cargo.toml'
+      - 'Cargo.lock'
+  workflow_dispatch:
+    inputs:
+      webkit_ref:
+        description: 'WebKit fork branch/tag/commit to build against'
+        required: false
+        default: 'caad865eb1a6e5ca4427f5ea1f066140b11953e7'
+        type: string
+
+concurrency:
+  group: ohos-build-rust-${{ github.ref }}
+  cancel-in-progress: true
+
+env:
+  OHOS_SDK_ROOT: /home/user/setup-ohos-sdk
+  OHOS_SYSROOT: /home/user/setup-ohos-sdk/ohos/native/sysroot
+  OHOS_CROSS_LIBS: /home/user/sources/bun/build/ohos-cross-libs
+  OHOS_ICU_DIR: /home/user/sources/bun/build/ohos-icu/target
+  # Rust incremental compilation
+  CARGO_INCREMENTAL: 1
+  CARGO_TARGET_DIR: /home/user/sources/bun/build/release-ohos/rust-target
+  # sccache (optional - removes gracefully if not found)
+  RUSTC_WRAPPER: ""
+  # Build parallelism — 11GB RAM limit on self-hosted runner
+  NINJA_JOBS: 2
+  # WebKit fork — pinned to c9296e353e (the WEBKIT_VERSION pin in
+  # scripts/build/deps/webkit.ts). Floating ohos-aarch64 branch moved to
+  # 8172ab945d8e (oven-sh main merge) which removed JSModuleRecord
+  # declaredVariables/lexicalVariables and changed create() signature;
+  # bun's BunAnalyzeTranspiledModule.cpp still uses the old API.
+  WEBKIT_FORK: oven-sh/WebKit
+  WEBKIT_REF: caad865eb1a6e5ca4427f5ea1f066140b11953e7
+
+jobs:
+  build:
+    name: Build Bun for OHOS (aarch64)
+    runs-on: [self-hosted, Linux, ARM64]
+    timeout-minutes: 300
+
+    steps:
+      - name: Checkout Bun source (incremental)
+        run: |
+          LOCAL=/home/user/sources/bun
+          rm -rf bun
+          if [ -d "$LOCAL/.git" ]; then
+            git clone --reference "$LOCAL/.git" \
+              https://ghfast.top/${{ github.server_url }}/${{ github.repository }}.git bun 2>/dev/null || \
+              git clone --depth 1 --branch "${{ github.ref_name }}" \
+                https://ghfast.top/${{ github.server_url }}/${{ github.repository }}.git bun
+            cd bun
+            # Checkout the commit that triggered this run (push SHA or PR merge),
+            # NOT a hardcoded branch — otherwise CI always builds ohos-aarch64
+            # regardless of which branch/PR was pushed.
+            git fetch origin "${{ github.ref }}" --depth=1
+            git checkout -f FETCH_HEAD
+            echo "✅ Cloned from local reference @ ${{ github.sha }}"
+          else
+            git clone --depth 1 --branch "${{ github.ref_name }}" \
+              https://ghfast.top/${{ github.server_url }}/${{ github.repository }}.git bun
+            echo "⚠️  Full clone (no local reference) @ ${{ github.sha }}"
+          fi
+
+      - name: Restore Rust cargo cache
+        run: |
+          mkdir -p bun/.cargo
+          SRC_CACHE=/home/user/sources/bun/.cargo
+          if [ -d "$SRC_CACHE/registry" ]; then
+            cp -a "$SRC_CACHE/registry" bun/.cargo/registry 2>/dev/null || true
+            echo "✅ Copied cargo registry cache"
+          else
+            echo "⚠️  No cargo registry cache found"
+          fi
+
+      - name: Restore Rust incremental build artifacts
+        run: |
+          SRC_TARGET=/home/user/sources/bun/build/release-ohos/rust-target
+          if [ -d "$SRC_TARGET" ]; then
+            mkdir -p bun/build/release-ohos
+            cp -a --link "$SRC_TARGET" bun/build/release-ohos/rust-target 2>/dev/null || \
+              cp -a "$SRC_TARGET" bun/build/release-ohos/rust-target 2>/dev/null || true
+            echo "✅ Copied Rust incremental artifacts"
+          else
+            echo "⚠️  No previous Rust artifacts (full rebuild)"
+          fi
+
+      - name: Checkout WebKit fork (incremental)
+        run: |
+          # Use vendor/WebKit from local source tree as reference (36GB .git,
+          # has ohos-aarch64 branch + oven-sh remote). The deps/WebKit
+          # under build dir is a cmake build output, not a git checkout.
+          LOCAL_WK=/home/user/sources/bun/vendor/WebKit
+          WK_REPO=${{ env.WEBKIT_FORK }}
+          WK_REF=${{ inputs.webkit_ref || env.WEBKIT_REF }}
+          rm -rf bun/vendor/WebKit
+          if [ -d "$LOCAL_WK/.git" ]; then
+            # Hardlink from local checkout — ~5s instead of 1h+ cloning WebKit via network
+            git clone --reference "$LOCAL_WK/.git" --dissociate \
+              --depth 1 --branch "$WK_REF" \
+              "https://ghfast.top/https://github.com/$WK_REPO.git" bun/vendor/WebKit 2>/dev/null || \
+            cp -a --link "$LOCAL_WK" bun/vendor/WebKit
+            cd bun/vendor/WebKit
+            git remote set-url origin "https://ghfast.top/https://github.com/$WK_REPO.git"
+            git fetch origin "$WK_REF" --depth=1 2>/dev/null || true
+            # Must use FETCH_HEAD — local branch from the initial clone
+            # still points to the old ref and `git checkout "$WK_REF"` would
+            # skip the just-fetched HEAD. Fall back to checking out WK_REF
+            # directly when the fetch is silently skipped but the local
+            # reference already contains the commit (the pinned-sha case).
+            git checkout -f FETCH_HEAD 2>/dev/null || git checkout -f "$WK_REF"
+            echo "✅ WebKit cloned from local reference"
+          else
+            git clone --depth 1 --branch "$WK_REF" \
+              "https://ghfast.top/https://github.com/$WK_REPO.git" bun/vendor/WebKit
+            echo "⚠️  Full WebKit clone (no local reference)"
+          fi
+
+      - name: WebKit version sync check
+        run: |
+          WK_HASH=$(grep "^export const WEBKIT_VERSION" bun/scripts/build/deps/webkit.ts | grep -oE '[a-f0-9]{40}')
+          echo "scripts/build/deps/webkit.ts pins: $WK_HASH"
+          if git -C bun/vendor/WebKit cat-file -e "${WK_HASH}" 2>/dev/null; then
+            echo "✅ vendor/WebKit already contains ${WK_HASH}"
+          else
+            echo "⚠️  vendor/WebKit missing ${WK_HASH} — trying upstream..."
+            cd bun/vendor/WebKit
+            git remote add upstream https://github.com/oven-sh/WebKit.git 2>/dev/null || true
+            if git fetch upstream main --depth=200 2>/dev/null && git cat-file -e "${WK_HASH}" 2>/dev/null; then
+              echo "⚠️  Commit exists upstream but not in fork — try manual merge via:"
+              echo "    gh api repos/oven-sh/WebKit/merges -X POST -f base=ohos-aarch64 -f head=${WK_HASH}"
+              echo "⚠️  Build will continue without auto-sync (merge preserves OHOS patches)"
+            else
+              echo "⚠️  Cannot verify commit ${WK_HASH} in upstream. Build will continue."
+            fi
+          fi
+
+      - name: Install system dependencies
+        run: |
+          # openEuler: libatomic required by node for msgpackr-extract postinstall
+          if ! rpm -q libatomic &>/dev/null; then
+            echo "⚠️  libatomic not found — installing..."
+            dnf install -y libatomic 2>&1 | tail -3
+            echo "✅ libatomic installed"
+          else
+            echo "✅ libatomic already installed"
+          fi
+
+      - name: Setup environment
+        run: |
+          echo "OHOS_SDK_ROOT=${{ env.OHOS_SDK_ROOT }}" >> $GITHUB_ENV
+          echo "OHOS_SYSROOT=${{ env.OHOS_SYSROOT }}" >> $GITHUB_ENV
+          echo "OHOS_CROSS_LIBS=${{ env.OHOS_CROSS_LIBS }}" >> $GITHUB_ENV
+          echo "OHOS_ICU_DIR=${{ env.OHOS_ICU_DIR }}" >> $GITHUB_ENV
+          test -d "$OHOS_SDK_ROOT" || { echo "OHOS SDK not found"; exit 1; }
+          mkdir -p bun/build
+          [ -L bun/build/ohos-cross-libs ] && [ "$(readlink bun/build/ohos-cross-libs)" = "$OHOS_CROSS_LIBS" ] || ln -sfn "$OHOS_CROSS_LIBS" bun/build/ohos-cross-libs
+          [ -L bun/build/ohos-icu ] && [ "$(readlink bun/build/ohos-icu)" = "$(dirname $OHOS_ICU_DIR)" ] || ln -sfn "$(dirname $OHOS_ICU_DIR)" bun/build/ohos-icu
+          test -d bun/build/ohos-cross-libs/libcxx/lib || { echo "Cross libs not found"; exit 1; }
+          test -d bun/build/ohos-icu/target/lib || { echo "ICU not found"; exit 1; }
+          # LLVM 22 must be in PATH for the build script to find clang >=21.1.0
+          echo "PATH=$OHOS_SDK_ROOT/llvm-22/bin:$PATH" >> $GITHUB_ENV
+          echo "CC=$OHOS_SDK_ROOT/llvm-22/bin/clang" >> $GITHUB_ENV
+          echo "CXX=$OHOS_SDK_ROOT/llvm-22/bin/clang++" >> $GITHUB_ENV
+          echo "✅ Environment ready (clang: $($OHOS_SDK_ROOT/llvm-22/bin/clang --version | head -1))"
+
+      - name: Restore incremental build artifacts
+        run: |
+          # The build.ninja is regenerated fresh by configure step.
+          # Restore cached WebKit + dependency build outputs for speed.
+          CACHE_DIR=/home/user/actions-runner/_work/_cache/ohos-build
+          if [ -d "$CACHE_DIR" ]; then
+            mkdir -p bun/build/release-ohos/deps
+            for dep_dir in deps/WebKit obj vendor; do
+              src="$CACHE_DIR/$dep_dir"
+              dst="bun/build/release-ohos/$dep_dir"
+              [ -d "$src" ] && cp -a --link "$src" "$dst" 2>/dev/null || true
+            done
+            echo "✅ Restored cached build artifacts"
+          else
+            echo "⚠️  No cached build artifacts (full build)"
+          fi
+
+      - name: Extract WebKit version for cache key
+        id: webkit-version
+        run: |
+          WK_VER=$(grep "^export const WEBKIT_VERSION" bun/scripts/build/deps/webkit.ts | grep -oE '[a-f0-9]{40}')
+          echo "version=${WK_VER}" >> $GITHUB_OUTPUT
+          echo "Cache key: webkit-ohos-rust-${{ inputs.webkit_ref || env.WEBKIT_REF }}-${WK_VER}"
+
+      - name: Cache WebKit build
+        uses: actions/cache@v4
+        id: webkit-cache
+        with:
+          path: bun/build/release-ohos/deps/WebKit
+          key: webkit-ohos-rust-${{ inputs.webkit_ref || env.WEBKIT_REF }}-${{ steps.webkit-version.outputs.version }}
+
+      - name: Configure Bun build
+        working-directory: bun
+        run: |
+          bun run build:release \
+            --os=ohos \
+            --arch=aarch64 \
+            --webkit=local \
+            --build-dir=build/release-ohos \
+            --ohos-sysroot=$OHOS_SYSROOT \
+            --configure-only
+        env:
+          CI: true
+
+      - name: Patch build.ninja for OHOS host compilation
+        working-directory: bun
+        run: |
+          # 1. Host 编译器改用系统 clang (dep_host_cc 规则)
+          #    LLVM 22 clang 找不到 GCC 运行时 (crtbeginS.o, -lgcc, -lgcc_s)
+          if grep -q "llvm-22/bin/clang \$flags -o \$out \$in" build/release-ohos/build.ninja 2>/dev/null; then
+            sed -i 's|command = .*/llvm-22/bin/clang $flags -o $out $in|command = /usr/bin/clang $flags -o $out $in|' \
+              build/release-ohos/build.ninja
+            echo "✅ Patched dep_host_cc to use system clang"
+          else
+            echo "⚠️ dep_host_cc rule not found or already patched"
+          fi
+          # 2. 修复 -lpthreads → -lpthread (WebKit CMake 生成错误)
+          if [ -f build/release-ohos/deps/WebKit/build.ninja ]; then
+            sed -i 's/-lpthreads/-lpthread/g' build/release-ohos/deps/WebKit/build.ninja
+            echo "✅ Patched -lpthreads → -lpthread"
+          fi
+          # 3. Rust HOST 链接器改用系统 clang++ (避免 -lgcc_s 找不到)
+          if [ -f .cargo/config.toml ] && grep -q 'aarch64-unknown-linux-gnu' .cargo/config.toml; then
+            python3 -c "
+          import re
+          with open('.cargo/config.toml', 'r') as f:
+              content = f.read()
+          content = re.sub(
+              r'\[target\.aarch64-unknown-linux-gnu\]\nlinker = \"[^\"]*\"',
+              '[target.aarch64-unknown-linux-gnu]\nlinker = \"/usr/bin/clang++\"',
+              content
+          )
+          with open('.cargo/config.toml', 'w') as f:
+              f.write(content)
+          print('✅ Patched Rust host linker to system clang++')
+          " || echo "⚠️ Could not patch .cargo/config.toml"
+          fi
+          # 4. RUSTUP 镜像: rsproxy.cn 首选 → tuna fallback → github 直连兜底
+          #    self-hosted runner 到 rsproxy 偶发不可达 (run 30622355212)
+          if ! grep -q "RUSTUP_DIST_SERVER" build/release-ohos/build.ninja 2>/dev/null; then
+            RUST_DATE=$(grep -oE 'nightly-[0-9]{4}-[0-9]{2}-[0-9]{2}' rust-toolchain.toml | head -1 | cut -d- -f2-)
+            RUSTUP_DIST_SERVER=""
+            RUSTUP_UPDATE_ROOT=""
+            for mirror in \
+              "https://rsproxy.cn|https://rsproxy.cn/rustup" \
+              "https://mirrors.tuna.tsinghua.edu.cn/rustup|https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup" \
+              "https://static.rust-lang.org|https://static.rust-lang.org/rustup"; do
+              dist_server=$(echo "$mirror" | cut -d'|' -f1)
+              if curl -sfI --max-time 6 "$dist_server/dist/$RUST_DATE/channel-rust-nightly.toml.sha256" -o /dev/null 2>&1; then
+                RUSTUP_DIST_SERVER="$dist_server"
+                RUSTUP_UPDATE_ROOT=$(echo "$mirror" | cut -d'|' -f2)
+                break
+              fi
+            done
+            if [ -z "$RUSTUP_DIST_SERVER" ]; then
+              echo "⚠️  No rustup mirror reachable, defaulting to rsproxy.cn"
+              RUSTUP_DIST_SERVER="https://rsproxy.cn"
+              RUSTUP_UPDATE_ROOT="https://rsproxy.cn/rustup"
+            fi
+            echo "✅ Selected RUSTUP mirror: $RUSTUP_DIST_SERVER"
+            sed -i "s|--env=CARGO_HOME=/home/user/.cargo|--env=CARGO_HOME=/home/user/.cargo --env=RUSTUP_DIST_SERVER=$RUSTUP_DIST_SERVER --env=RUSTUP_UPDATE_ROOT=$RUSTUP_UPDATE_ROOT|g" \
+              build/release-ohos/build.ninja 2>/dev/null || true
+            echo "✅ Added RUSTUP mirror config ($RUSTUP_DIST_SERVER)"
+          fi
+
+      - name: Build WebKit
+        if: steps.webkit-cache.outputs.cache-hit != 'true'
+        working-directory: bun
+        run: |
+          ninja -C build/release-ohos configure-WebKit -j1
+          ninja -C build/release-ohos/deps/WebKit jsc -j$NINJA_JOBS
+
+      - name: Build Bun
+        working-directory: bun
+        run: |
+          # First run may fail on msgpackr-extract node-gyp (optional dep, harmless)
+          ninja -C build/release-ohos bun -j$NINJA_JOBS || {
+            echo "⚠️ First ninja run failed (likely optional npm dep), retrying..."
+            ninja -C build/release-ohos bun -j$NINJA_JOBS
+          }
+
+      - name: Verify binary
+        working-directory: bun
+        run: |
+          file build/release-ohos/bun
+          ls -lh build/release-ohos/bun
+          file build/release-ohos/bun | grep -q "ELF.*ARM aarch64" || {
+            echo "ERROR: Not an ARM64 ELF binary"
+            file build/release-ohos/bun
+            exit 1
+          }
+          # OHOS now dynamically links system libc.so (and optionally libc++.so).
+          # Verify only expected NEEDED entries exist.
+          NEEDED=$(readelf -d build/release-ohos/bun | grep "NEEDED" | sed 's/.*\[//;s/\]//')
+          echo "NEEDED libraries: $NEEDED"
+          for lib in $NEEDED; do
+            case "$lib" in
+              libc.so|libc++.so) echo "✅ Expected: $lib" ;;
+              *)
+                echo "ERROR: Unexpected dynamic dependency: $lib"
+                readelf -d build/release-ohos/bun | grep "NEEDED"
+                exit 1
+                ;;
+            esac
+          done
+          echo "✅ Binary validation passed"
+
+      - name: Package binary
+        working-directory: bun
+        run: |
+          VERSION=$(build/release-ohos/bun --version 2>/dev/null || python3 -c "import json; print(json.load(open('package.json'))['version'])")
+          COMMIT=$(git rev-parse --short HEAD)
+          DATE=$(date +%Y%m%d_%H%M%S)
+          NAME="bun-ohos-aarch64-${VERSION}-${COMMIT}-${DATE}"
+          mkdir -p /tmp/bun-release/${NAME}
+          cp build/release-ohos/bun /tmp/bun-release/${NAME}/bun
+          cat > /tmp/bun-release/${NAME}/README.md << 'EOF'
+          # Bun for HarmonyOS (OHOS)
+          Rust-based build. See ljy9812/bun on GitHub for details.
+          EOF
+          cd /tmp/bun-release
+          tar czf ${NAME}.tar.gz ${NAME}/
+          echo "artifact_name=${NAME}" >> $GITHUB_ENV
+          echo "artifact_path=/tmp/bun-release/${NAME}.tar.gz" >> $GITHUB_ENV
+
+      - name: Copy artifacts to shared directory
+        working-directory: bun
+        run: |
+          SHARE=/mnt/linux_share/ci-test
+          mkdir -p $SHARE
+          cp build/release-ohos/bun $SHARE/bun-ohos-rust-${{ env.artifact_name }}.elf
+          echo "✅ 制品已复制到 $SHARE/bun-ohos-rust-${{ env.artifact_name }}.elf"
