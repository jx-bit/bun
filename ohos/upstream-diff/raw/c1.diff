+        let mut st: libc::stat = unsafe { core::mem::zeroed() };
+        // SAFETY: proc_buf is NUL-terminated by the assignment above.
+        return unsafe { libc::stat(proc_buf.as_ptr().cast(), &raw mut st) } < 0
+            && crate::ffi::errno() == libc::ENOENT;
+    }
+    false
+}
